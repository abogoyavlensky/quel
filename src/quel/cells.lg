(ns quel.cells
  (:require [string :as str]))

;; Driver values to cells the grid can render. Every value crosses the
;; bridge as JSON, so whatever JavaScript would mangle is converted here,
;; and nothing is allowed to fail: an unknown value falls back to its
;; string form.
;;
;; Values arrive as the sql shim scans them. modernc (SQLite) returns TEXT
;; and BLOB as []byte, which the shim surfaces as strings. pgx (Postgres,
;; Redshift) returns numeric, uuid, json, intervals and arrays as strings,
;; and date, timestamp and timestamptz as Go time.Time values, formatted
;; here by the column's type. bytea also arrives as a string, and so does
;; a BLOB: let-go boxes a []byte as a Go string with the same bytes, so
;; (bytes s) gets them back and they go out as hex. Only a SQLite column
;; with no declared type is missed: its blobs cannot be told from text.
;;
;; DuckDB's own scan (duckdb.shim/ScanRow) has done most of the work:
;; dates, times, DECIMAL and HUGEINT arrive as strings. What is left is a
;; LIST, ARRAY, STRUCT, MAP or JSON value, which arrives as a vector or a
;; map and goes out as JSON text (the grid's JSON viewer knows the types),
;; and an INTERVAL, which arrives as {:months :days :micros} and goes out
;; as DuckDB prints it.
;; The large-text cap comes later.

;; The largest integer a JavaScript number holds exactly: 2^53 - 1.
(def ^:private max-safe-int 9007199254740991)

(defn- non-finite
  "The JSON-safe name of an infinite or NaN float, or nil for a finite
   one. Go's JSON encoder rejects them, and SQLite returns them for valid
   queries (`select 1e999`)."
  [x]
  (cond
    (NaN? x) "NaN"
    (infinite? x) (if (pos? x) "Infinity" "-Infinity")))

(def ^:private binary-types #{"BYTEA" "BLOB"})

;; Past this many bytes a binary value shows its size, not its bytes: a
;; page of large blobs would flood the bridge.
(def ^:private max-binary-bytes 65536)

;; "00" to "ff", so hex needs no format call per byte.
(def ^:private hex-pairs
  (mapv (fn [b] (str (get "0123456789abcdef" (quot b 16)) (get "0123456789abcdef" (rem b 16))))
        (range 256)))

(defn- binary? [type-name]
  (and (string? type-name) (contains? binary-types (str/upper-case type-name))))

(defn- hex
  "A binary value, held as a string, as Postgres-style hex: \\x and two
   lowercase digits per byte."
  [s]
  (let [bs (bytes s)
        n (count bs)]
    (if (> n max-binary-bytes)
      (str "(binary, " n " bytes)")
      (apply str "\\x" (map (fn [b] (hex-pairs (bit-and b 0xff))) bs)))))

;; Go time layouts per column type: ISO-8601, as precise as the value.
(def ^:private time-layouts
  {"DATE" "2006-01-02"
   "TIMESTAMP" "2006-01-02T15:04:05.999999"
   "TIMESTAMPTZ" "2006-01-02T15:04:05.999999Z07:00"})

;; pgx names only the types in its type map and reports any other as its
;; OID. These are the ones worth a name.
(def ^:private oid-names
  {:redshift {"4000" "SUPER"}})

(defn type-names
  "The driver's column type names as the grid shows them: an OID pgx has
   no name for becomes its type's name, anything else stays as it is."
  [engine names]
  (let [known (get oid-names engine)]
    (mapv #(get known % %) names)))

(defn- go-time? [v]
  (= "go.time.Time" (str (type v))))

(defn- unit
  "n and its unit, plural unless n is 1 or -1: \"2 years\", \"-1 day\"."
  [n word]
  (str n " " word (when-not (= 1 (abs n)) "s")))

(defn- two [n] (if (< n 10) (str "0" n) (str n)))

(defn- clock
  "micros as DuckDB prints an interval's time part: [-]hh:mm:ss, with a
   fraction when there is one, its trailing zeros trimmed."
  [micros]
  (let [us (abs micros)
        secs (quot us 1000000)
        frac (rem us 1000000)]
    (str (when (neg? micros) "-")
         (two (quot secs 3600)) ":" (two (rem (quot secs 60) 60)) ":" (two (rem secs 60))
         (when (pos? frac)
           (str "." (str/replace (subs (str (+ 1000000 frac)) 1) #"0+$" ""))))))

(defn- interval
  "A DuckDB INTERVAL, {:months :days :micros}, as DuckDB prints it: \"1
   year 2 months 3 days 01:30:00\", each part left out when zero, and
   \"00:00:00\" for a zero interval."
  [{:keys [months days micros]}]
  (let [years (quot months 12)
        months (rem months 12)
        parts (cond-> []
                (not (zero? years)) (conj (unit years "year"))
                (not (zero? months)) (conj (unit months "month"))
                (not (zero? days)) (conj (unit days "day"))
                (not (zero? micros)) (conj (clock micros)))]
    (if (empty? parts) "00:00:00" (str/join " " parts))))

(defn- json-text
  "A nested value as JSON text, or its string form if it has no JSON one."
  [v]
  (try (json/write-json v) (catch _ (str v))))

(defn encode
  "One driver value as a bridge-safe cell, given its column's type name
   (as `type-names` returns it; nil when unknown)."
  ([v] (encode nil v))
  ([type-name v]
   (cond
     (nil? v) nil
     ;; Before strings: bytea and blobs arrive as one. SQLite lets a BLOB
     ;; column hold a number, which takes the normal path.
     (and (binary? type-name) (string? v)) (hex v)
     (boolean? v) v
     (string? v) v
     (int? v) (if (<= (- max-safe-int) v max-safe-int) v (str v))
     (number? v) (or (non-finite v) v)
     (go-time? v) (.Format v (get time-layouts type-name "2006-01-02T15:04:05.999999Z07:00"))
     (and (= "INTERVAL" type-name) (map? v)) (try (interval v) (catch _ (str v)))
     (or (vector? v) (map? v)) (json-text v)
     :else (str v))))

(defn encode-row
  "A row of driver values, in column order, as a vector of cells. types
   are the columns' type names, in the same order."
  ([row] (mapv encode row))
  ([types row] (mapv encode types row)))
