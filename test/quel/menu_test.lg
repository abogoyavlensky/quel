(ns quel.menu-test
  (:require [quel.menu :as menu]
            [wails.core :as w]
            [clojure.test :refer [deftest is]]))

;; check-menu builds the spec with Wails, which needs the application to
;; exist; nothing is run or shown.
(defonce ^:private app (delay (w/new-app {:name "quel-test"})))

(defn- on-clicks [items]
  (mapcat (fn [item]
            (concat (when (contains? item :on-click) [(:on-click item)])
                    (on-clicks (:items item))))
          items))

(deftest the-spec-is-data
  (is (vector? (menu/spec {:app nil}))))

(defn- labels [items]
  (mapcat (fn [item] (cons (:label item) (labels (:items item)))) items))

(deftest every-item-with-a-click-has-one
  (is (= 7 (count (on-clicks (menu/spec {:app nil}))))))

(deftest the-tab-and-query-items-are-there
  (is (every? (set (labels (menu/spec {:app nil})))
              ["New Tab" "New Connection…" "Open Database…" "Close Tab" "Query" "Run" "Run Script" "Cancel"])))

(deftest wails-accepts-the-spec
  @app
  (is (true? (w/check-menu (menu/spec {:app nil})))))
