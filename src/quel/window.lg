(ns quel.window
  (:require [sql.core :as sql]
            [string :as str]))

;; What Quel remembers about its window, in the settings table: the zoom
;; level, whether it was left maximised or fullscreen, and the normal
;; window's frame. Zoom and state have a row only away from their default.
;; Nothing here calls Wails; quel.api and quel.shell apply these to the
;; window.
;;
;; Quel keeps its own ladder of levels. Wails' ZoomIn and ZoomOut step
;; differently per platform, and GetZoom passes through a C float (1.1
;; comes back as 1.10000002), so the saved level is the truth. The ladder
;; starts at 100%: Wails clamps anything lower. It stops at 150%: there the
;; window's 720×480 minimum is 480×320 CSS px, and the title strip's 24px
;; pill still fits the 38pt band that macOS centres the traffic lights in.

(def zoom-levels [1.0 1.1 1.25 1.5])

(def ^:private default-zoom (first zoom-levels))

(defn- setting [db k]
  (:value (sql/execute-one! db ["select value from settings where key = ?" k])))

(defn- put-setting! [db k value]
  (sql/execute! db [(str "insert into settings (key, value) values (?, ?)"
                         " on conflict (key) do update set value = excluded.value")
                    k value]))

(defn- delete-setting! [db k]
  (sql/execute! db ["delete from settings where key = ?" k]))

(defn- nearest-level [level]
  (apply min-key #(abs (- % level)) zoom-levels))

(defn zoom-level
  "The saved level, on the ladder; 100% when none is saved or it is
   unreadable."
  [db]
  (let [saved (some-> (setting db "zoom") parse-double)]
    (if saved (nearest-level saved) default-zoom)))

(defn save-zoom!
  "Remember the zoom level."
  [db level]
  (if (= default-zoom level)
    (delete-setting! db "zoom")
    (put-setting! db "zoom" (str level)))
  nil)

(defn next-zoom
  "The level after `level` going \"in\", \"out\" or \"reset\". It stays put at
   the ends of the ladder."
  [level direction]
  (case direction
    "in" (or (first (filter #(> % level) zoom-levels)) (last zoom-levels))
    "out" (or (last (filter #(< % level) zoom-levels)) default-zoom)
    "reset" default-zoom
    (throw (ex-info (str "Unknown zoom direction: " direction) {:direction direction}))))

(def ^:private start-states {"maximised" :maximised "fullscreen" :fullscreen})

(defn start-state
  "The state the window was left in: :normal, :maximised or :fullscreen."
  [db]
  (get start-states (setting db "window-state") :normal))

(defn save-start-state!
  "Remember the state the window is in."
  [db state]
  (if (= :normal state)
    (delete-setting! db "window-state")
    (put-setting! db "window-state" (name state)))
  nil)

(defn state-of
  "The window's state from its two checks. A fullscreen window may also
   report as maximised, so fullscreen goes first."
  [maximised? fullscreen?]
  (cond
    fullscreen? :fullscreen
    maximised? :maximised
    :else :normal))

;; The normal window's frame: {:x :y :width :height}, in Wails' units (on
;; macOS, points from the primary screen's top-left corner). It is saved
;; only while the window is normal, so a maximised session keeps the frame
;; it is restored to.

(def default-size {:width 1200 :height 800})

(def min-size {:width 720 :height 480})

(defn- parse-frame [s]
  (let [parts (some-> s (str/split #","))
        [x y width height :as ns] (map #(parse-long (str/trim %)) parts)]
    (when (and (= 4 (count parts)) (every? some? ns))
      {:x x :y y :width width :height height})))

(defn window-frame
  "The normal window's saved frame, or nil when none is saved or it is
   unreadable."
  [db]
  (parse-frame (setting db "window-frame")))

(defn save-window-frame!
  "Remember the normal window's frame."
  [db {:keys [x y width height]}]
  (put-setting! db "window-frame" (str/join "," [x y width height]))
  nil)

(defn start-opts
  "The new-window options for the saved state and frame. A maximised or
   fullscreen window gets the frame's size but no position: Wails applies
   the start state before the position, and moving a zoomed window would
   knock it off its zoomed frame. The size never goes below min-size."
  [state frame]
  (let [size (merge default-size (select-keys frame [:width :height]))]
    (cond-> {:start-state state
             :width (max (:width size) (:width min-size))
             :height (max (:height size) (:height min-size))}
      (and frame (= :normal state)) (assoc :x (:x frame) :y (:y frame)))))

(defn fit-frame
  "`frame` moved and shrunk to lie inside `area`, both {:x :y :width
   :height}. The size shrinks to the area first, then the corner moves in.
   A frame that already fits, or a nil area, comes back as it is."
  [frame area]
  (if-not area
    frame
    (let [{:keys [x y width height]} frame
          w (min width (:width area))
          h (min height (:height area))]
      {:width w
       :height h
       :x (-> x (max (:x area)) (min (- (+ (:x area) (:width area)) w)))
       :y (-> y (max (:y area)) (min (- (+ (:y area) (:height area)) h)))})))
