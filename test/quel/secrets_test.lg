(ns quel.secrets-test
  (:require [integrant.core :as ig]
            [quel.secrets :as secrets]
            [clojure.test :refer [deftest is]]))

(def s (ig/init-key :quel.secrets/store {:backend :memory}))

(deftest save-read-overwrite-delete
  (is (nil? (secrets/password s "p1")))
  (secrets/set-password! s "p1" "one")
  (is (= "one" (secrets/password s "p1")))
  (secrets/set-password! s "p1" " two ")
  (is (= " two " (secrets/password s "p1")))
  (secrets/delete-password! s "p1")
  (is (nil? (secrets/password s "p1")))
  (is (nil? (secrets/delete-password! s "p1"))))

(deftest ids-stay-apart
  (secrets/set-password! s "a" "pa")
  (secrets/set-password! s "b" "pb")
  (is (= ["pa" "pb"] [(secrets/password s "a") (secrets/password s "b")]))
  (secrets/delete-password! s "a")
  (is (= [nil "pb"] [(secrets/password s "a") (secrets/password s "b")]))
  (secrets/delete-password! s "b"))

(deftest the-component
  (is (= {:service "Quel" :backend :memory} s)))
