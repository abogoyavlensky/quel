(ns quel.pg-test
  (:require [integrant.core :as ig]
            [quel.api :as api]
            [quel.conn :as conn]
            [quel.exec :as exec]
            [quel.meta :as meta]
            [quel.meta.postgres]
            [sql.core :as sql]
            [string :as str]
            [clojure.test :refer [deftest is]]))

;; Against a real Postgres: `lgx test-pg` runs these with a throwaway one in
;; Docker (scripts/with-postgres.sh sets QUEL_PG_URL). Plain `lgx test`
;; skips them.

(def pg-url (os/getenv "QUEL_PG_URL"))
(def enabled? (not (str/blank? pg-url)))

(when-not enabled?
  (println "quel.pg-test: QUEL_PG_URL is unset, skipping (lgx test-pg runs them)"))

(defmacro with-pg
  "Run body only when a Postgres is configured."
  [& body]
  `(when enabled? ~@body))

(defn with-registry
  "Run (f registry) over a fresh registry, halting it afterwards."
  [f]
  (let [registry (ig/init-key :quel.conn/registry {})]
    (try (f registry)
         (finally (ig/halt-key! :quel.conn/registry registry)))))

(defn- message-of [f]
  (try (f) nil (catch e (ex-message e))))

(deftest open-a-postgres-url
  (with-pg
    (with-registry
      (fn [registry]
        (let [{:keys [conn-id engine label]} (conn/open! registry pg-url)]
          (is (string? conn-id))
          (is (= :postgres engine))
          (is (str/includes? label ":***@"))
          (is (not (str/includes? label "quel@")) "the password is masked")
          (is (nil? (conn/close! registry conn-id)))
          (is (= {} @registry)))))))

(deftest a-wrong-password-fails-at-open
  (with-pg
    (with-registry
      (fn [registry]
        (let [bad (str/replace pg-url #":quel@" ":wrong@")
              msg (message-of #(conn/open! registry bad))]
          (is (str/includes? (str msg) "password authentication failed") (str "got " (pr-str msg)))
          (is (= {} @registry) "nothing is left registered"))))))

(defn with-env
  "Run (f execs conns conn-id) over fresh registries and an open Postgres,
   halting both afterwards in the system's order."
  [f]
  (let [conns (ig/init-key :quel.conn/registry {})
        execs (ig/init-key :quel.exec/registry {:conns conns})]
    (try
      (f execs conns (:conn-id (conn/open! conns pg-url)))
      (finally
        (ig/halt-key! :quel.exec/registry execs)
        (ig/halt-key! :quel.conn/registry conns)))))

(defn- run [execs conns conn-id q]
  (exec/run! execs conns {:conn-id conn-id :session-id "s1" :query-id (str (random-uuid)) :sql q}))

(defn- first-cell [execs conns conn-id q]
  (ffirst (:rows (run execs conns conn-id q))))

(deftest select-insert-returning
  (with-pg
    (with-env
      (fn [execs conns id]
        (let [r (run execs conns id "select 1::int4 as a, 'x'::text as b")]
          (is (= [{:name "a" :type "INT4"} {:name "b" :type "TEXT"}] (:columns r)))
          (is (= [[1 "x"]] (:rows r))))
        (run execs conns id "create temp table t (id serial, x int)")
        (is (= 2 (:update-count (run execs conns id "insert into t (x) values (1), (2)"))))
        (is (= [[3]] (:rows (run execs conns id "insert into t (x) values (3) returning id"))))))))

(deftest a-cancel-keeps-the-session
  (with-pg
    (with-env
      (fn [execs conns id]
        (run execs conns id "create temp table kept (x int)")
        (let [qid (str (random-uuid))
              t0 (System/nanoTime)
              f (future (try (exec/run! execs conns {:conn-id id :session-id "s1" :query-id qid
                                                     :sql "select pg_sleep(30)"})
                             (catch e (ex-message e))))]
          (sleep 300)
          (is (true? (exec/cancel! execs qid)))
          (is (= "Query canceled." (deref f 5000 :timeout)))
          (is (< (/ (- (System/nanoTime) t0) 1000000) 5000)))
        (is (= 0 (first-cell execs conns id "select count(*) from kept"))
            "the temp table survived, so the session did")))))

(defn- message-of-run [execs conns id q]
  (try (run execs conns id q) nil (catch e (ex-message e))))

(deftest a-dead-session-is-reset
  (with-pg
    (with-env
      (fn [execs conns id]
        (let [pid (first-cell execs conns id "select pg_backend_pid()")]
          (sql/execute! (conn/db conns id) [(str "select pg_terminate_backend(" pid ")")])
          (let [msg (message-of-run execs conns id "select 1")]
            (is (str/ends-with? (str msg) "The session was reset.") (str "got " (pr-str msg))))
          (let [pid2 (first-cell execs conns id "select pg_backend_pid()")]
            (is (int? pid2) "the next run works")
            (is (not= pid pid2) "on a fresh connection")))))))

(deftest an-aborted-transaction-keeps-the-session
  (with-pg
    (with-env
      (fn [execs conns id]
        (let [pid (first-cell execs conns id "select pg_backend_pid()")]
          (run execs conns id "begin")
          (let [msg (message-of-run execs conns id "select 1/0")]
            (is (str/includes? (str msg) "division by zero"))
            (is (not (str/includes? (str msg) "reset"))))
          (is (str/includes? (str (message-of-run execs conns id "select 1"))
                             "current transaction is aborted"))
          (run execs conns id "rollback")
          (is (= pid (first-cell execs conns id "select pg_backend_pid()"))
              "the same connection throughout"))))))

(deftest two-tabs-two-sessions
  (with-pg
    (with-env
      (fn [execs conns id]
        (let [in (fn [sid q] (exec/run! execs conns {:conn-id id :session-id sid
                                                    :query-id (str (random-uuid)) :sql q}))]
          (in "a" "create temp table only_a (x int)")
          (is (= [[0]] (:rows (in "a" "select count(*) from only_a"))))
          (is (str/includes? (str (try (in "b" "select count(*) from only_a") nil
                                       (catch e (ex-message e))))
                             "does not exist"))
          (is (not= (ffirst (:rows (in "a" "select pg_backend_pid()")))
                    (ffirst (:rows (in "b" "select pg_backend_pid()"))))))))))

(defn- utc-minute-of-day
  "Minutes past midnight UTC of an ISO-8601 timestamp with an offset (Z, or
   +HH:MM / -HH:MM, fractional-hour zones included), or nil if s is not
   one."
  [s]
  (when-let [[_ h m zone sign oh om]
             (re-matches #"\d{4}-\d\d-\d\dT(\d\d):(\d\d):\d\d(?:\.\d+)?(Z|([+-])(\d\d):(\d\d))" (str s))]
    (let [local (+ (* 60 (parse-long h)) (parse-long m))
          offset (if (= "Z" zone)
                   0
                   (* (if (= "+" sign) 1 -1) (+ (* 60 (parse-long oh)) (parse-long om))))]
      (mod (- local offset) 1440))))

(deftest dates-timestamps-and-binary-become-cells
  (with-pg
    (with-env
      (fn [execs conns id]
        (let [r (run execs conns id
                     (str "select date '2026-10-21' d,"
                          " timestamp '2026-10-21 10:00:00.5' ts,"
                          " timestamptz '2026-10-21 10:00:00+02' tz,"
                          " '\\xdeadbeef'::bytea b,"
                          " 1.50::numeric(10,2) n,"
                          " 9007199254740993::int8 big,"
                          " null::date nd"))]
          (is (= ["DATE" "TIMESTAMP" "TIMESTAMPTZ" "BYTEA" "NUMERIC" "INT8" "DATE"]
                 (mapv :type (:columns r))))
          ;; pgx decodes timestamptz in the machine's local zone, so the offset
          ;; varies by machine: check the hour against the offset given.
          (let [[d ts tz b n big nd] (first (:rows r))]
            (is (= "2026-10-21" d))
            (is (= "2026-10-21T10:00:00.5" ts))
            (is (= (* 8 60) (utc-minute-of-day tz)) (str "got " tz))
            (is (= "(binary)" b))
            (is (= "1.50" n))
            (is (= "9007199254740993" big))
            (is (nil? nd))))))))

;; Open cursors on Postgres.

(defn- until
  "Poll pred every 10 ms for up to 5 s; its last value."
  [pred]
  (loop [n 0]
    (let [v (pred)]
      (if (or v (>= n 500)) v (do (sleep 10) (recur (inc n)))))))

(defn- run-q [execs conns id qid q & {:as opts}]
  (exec/run! execs conns (merge {:conn-id id :session-id "s1" :query-id qid :sql q} opts)))

(deftest closing-a-big-cursor-is-quick-and-keeps-the-session
  (with-pg
    (with-env
      (fn [execs conns id]
        (run execs conns id "create temp table kept (x int)")
        (let [r (run-q execs conns id "big" "select * from generate_series(1, 10000000)")]
          (is (true? (:has-more r))))
        (let [t0 (System/nanoTime)]
          (exec/close-result! execs "big")
          (is (< (quot (- (System/nanoTime) t0) 1000000) 3000) "drain, then cancel"))
        (is (= 0 (first-cell execs conns id "select count(*) from kept"))
            "the temp table survived, so the session did")))))

(deftest a-new-run-inside-a-transaction-keeps-it
  (with-pg
    (with-env
      (fn [execs conns id]
        (run execs conns id "begin")
        (run execs conns id "create temp table tx (x int)")
        (is (true? (:has-more (run-q execs conns id "small" "select * from generate_series(1, 20000)"))))
        (is (= 1 (:update-count (run execs conns id "insert into tx values (1)")))
            "closing the cursor drained it: the transaction is not aborted")
        (run execs conns id "commit")
        (is (= 1 (first-cell execs conns id "select count(*) from tx")))))))

(deftest cancel-a-slow-page
  (with-pg
    (with-env
      (fn [execs conns id]
        (run execs conns id "create temp table kept2 (x int)")
        (run-q execs conns id "slow" "select pg_sleep(0.01) from generate_series(1, 100000)"
               :page-size 1)
        (let [page (future (try (exec/fetch-page! execs conns "slow" 50000)
                                (catch e (ex-message e))))]
          (is (until #(= :fetching (get-in @execs ["slow" :state]))))
          (sleep 200)
          (is (true? (exec/cancel! execs "slow")))
          (is (= "Query canceled." (deref page 5000 :timeout))))
        (is (= {} @execs))
        (is (= 0 (first-cell execs conns id "select count(*) from kept2"))
            "the session survived")))))

(deftest a-run-is-cancellable-while-the-previous-cursor-drains
  (with-pg
    (with-env
      (fn [execs conns id]
        (run execs conns id "create temp table kept3 (x int)")
        (is (true? (:has-more (run-q execs conns id "big" "select * from generate_series(1, 10000000)"))))
        ;; This run first drains "big" for up to drain-ms; it is registered
        ;; meanwhile, so the cancel finds it and it never starts.
        (let [next-run (future (try (run-q execs conns id "next" "select pg_sleep(30)")
                                    (catch e (ex-message e))))]
          (is (until #(= :running (get-in @execs ["next" :state]))))
          (is (true? (exec/cancel! execs "next")))
          (is (= "Query canceled." (deref next-run 5000 :timeout))))
        (is (= {} @execs))
        (is (= 0 (first-cell execs conns id "select count(*) from kept3"))
            "the session survived")))))

(defn pg-parts
  "QUEL_PG_URL's parts, as a profile's fields: postgres://user:pw@host:port/db."
  []
  (let [[_ user pw host port db] (re-find #"^postgres(?:ql)?://([^:]+):([^@]*)@([^:/]+):(\d+)/([^?]+)" pg-url)]
    {:user user :password pw :host host :port (parse-long port) :database db}))

(deftest open-a-dsn-target
  (with-pg
    (with-registry
      (fn [registry]
        (let [{:keys [user password host port database]} (pg-parts)
              dsn (str "host=" (conn/dsn-quote host) " port=" (conn/dsn-quote (str port))
                       " dbname=" (conn/dsn-quote database) " user=" (conn/dsn-quote user)
                       " password=" (conn/dsn-quote password) " sslmode='disable'")
              t {:engine :postgres :dsn dsn :label "Local" :secret password}
              {:keys [conn-id] :as r} (conn/open-target! registry t)]
          (is (= {:engine :postgres :label "Local"} (dissoc r :conn-id)))
          (is (= [{:one 1}] (sql/execute! (conn/db registry conn-id) ["select 1 as one"])))
          (is (nil? (conn/check! t)))
          (conn/close! registry conn-id))))))

(defn- with-api-env [f]
  (let [conns (ig/init-key :quel.conn/registry {})
        execs (ig/init-key :quel.exec/registry {:conns conns})
        dir (str/trim (:out (os/sh "mktemp" "-d")))
        store (ig/init-key :quel.store/db {:dir dir})
        secrets (ig/init-key :quel.secrets/store {:backend :memory})]
    (try
      (f {:conns conns :execs execs :store store :secrets secrets :app nil})
      (finally
        (ig/halt-key! :quel.exec/registry execs)
        (ig/halt-key! :quel.conn/registry conns)
        (ig/halt-key! :quel.store/db store)
        (os/sh "rm" "-rf" dir)))))

(defn- pg-form []
  (let [{:keys [user password host port database]} (pg-parts)]
    {"name" "Local PG" "engine" "postgres" "host" host "port" port "database" database
     "user" user "password" password "ssl-mode" "disable"}))

(deftest a-postgres-profile
  (with-pg
    (with-api-env
      (fn [env]
        (let [form (pg-form)
              p (api/save-profile env form)]
          (is (:has-password p))
          (is (= {:ok true :label "Local PG"} (api/test-connection env form)) "the typed password")
          (is (= {:ok true :label "Local PG"} (api/test-connection env (-> form (dissoc "password") (assoc "id" (:id p)))))
              "the saved password")
          ;; Forget wins over the saved password, so the test fails though
          ;; the saved one works.
          (let [msg (message-of #(api/test-connection env (-> form (dissoc "password")
                                                               (assoc "id" (:id p) "forget-password" true))))]
            (is (str/includes? (str msg) "password") (str "got " (pr-str msg))))
          (let [{:keys [conn-id]} (api/connect env (:id p))]
            (is (= [[1]] (:rows (api/run env conn-id "s1" "q1" "select 1"))))
            (api/close-db env conn-id)))))))

(deftest a-wrong-profile-password-is-redacted
  (with-pg
    (with-api-env
      (fn [env]
        (let [bad "wr0ng' \\pw"
              msg (message-of #(api/test-connection env (assoc (pg-form) "password" bad)))]
          (is (str/includes? (str msg) "password authentication failed") (str "got " (pr-str msg)))
          (is (not (str/includes? (str msg) "wr0ng")) msg))))))

;; Introspection. Each run makes a schema of its own and drops it, so
;; reruns against a kept database stay clean.

(defn- with-meta-schema
  "Run (f db schema) over a pool on Postgres and a fresh schema holding a
   table, a view, a materialized view, a partitioned table with one
   partition and a mixed-case table."
  [f]
  (with-registry
    (fn [registry]
      (let [{:keys [conn-id]} (conn/open! registry pg-url)
            db (conn/db registry conn-id)
            schema (str "quel_meta_" (rand-int 1000000000))
            q (fn [s] (sql/execute! db [s]))]
        (q (str "create schema " schema))
        (try
          (doseq [s [(str "create table " schema ".items (id int4, label varchar(20), price numeric(10,2))")
                     (str "create view " schema ".item_labels as select label from " schema ".items")
                     (str "create materialized view " schema ".item_prices as select price from " schema ".items")
                     (str "create table " schema ".events (at date) partition by range (at)")
                     (str "create table " schema ".events_2026 partition of " schema ".events"
                          " for values from ('2026-01-01') to ('2027-01-01')")
                     (str "create table " schema ".\"MixedCase\" (x int)")]]
            (q s))
          (f db schema)
          (finally (q (str "drop schema " schema " cascade"))))))))

(deftest postgres-introspection
  (with-pg
    (with-meta-schema
      (fn [db schema]
        (let [names (set (map :name (meta/schemas :postgres db)))]
          (is (contains? names schema))
          (is (some #(= {:name "public" :default true} %) (meta/schemas :postgres db)))
          (is (not-any? names ["pg_catalog" "pg_toast" "information_schema"])))
        (is (= [{:name "MixedCase" :kind "table"}
                {:name "events" :kind "table"}
                {:name "item_labels" :kind "view"}
                {:name "item_prices" :kind "materialized-view"}
                {:name "items" :kind "table"}]
               (meta/objects :postgres db schema)))
        (is (= [{:name "id" :type "integer"}
                {:name "label" :type "character varying(20)"}
                {:name "price" :type "numeric(10,2)"}]
               (meta/columns :postgres db schema "items")))
        (is (= [] (meta/columns :postgres db schema "nope")))
        (let [c (meta/completion-schema :postgres db)]
          (is (= "public" (:default-schema c)))
          (is (= ["id" "label" "price"] (get-in c [:schemas schema "items"])))
          (is (= ["x"] (get-in c [:schemas schema "MixedCase"])))
          (is (not (contains? (get-in c [:schemas schema]) "events_2026"))))))))

(deftest redshift-introspection-parses-on-postgres
  (with-pg
    (with-meta-schema
      (fn [db schema]
        (is (= (meta/schemas :postgres db) (meta/schemas :redshift db)))
        (is (= ["MixedCase" "events" "events_2026" "item_labels" "item_prices" "items"]
               (mapv :name (meta/objects :redshift db schema)))
            "no relispartition filter: the partition is listed")
        (is (= (meta/columns :postgres db schema "items") (meta/columns :redshift db schema "items")))
        (let [c (meta/completion-schema :redshift db)]
          (is (= "public" (:default-schema c)))
          (is (= ["id" "label" "price"] (get-in c [:schemas schema "items"]))))))))
