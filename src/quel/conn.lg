(ns quel.conn
  (:refer-clojure :exclude [close!])
  (:require [duckdb.core :as duckdb]
            [integrant.core :as ig]
            [postgres.core :as pg]
            [sql.core :as sql]
            [sql.shim :as shim]
            [sqlite.core :as sqlite]
            [string :as str]))

;; Open databases, keyed by a conn-id the frontend holds. Each entry is
;; {:db <connectable> :sessions-db <connectable>
;;  :engine <:sqlite :duckdb :postgres :redshift> :label <string>
;;  :sessions {session-id <*sql.Conn>} :retired #{session-id}}.
;;
;; What to open arrives as one string: a SQLite file path, or a
;; postgres:// / postgresql:// / redshift:// URL. Postgres and Redshift
;; share the pgx driver; the engine is kept for what differs later (the
;; catalog queries). A password in the URL is a stopgap until connection
;; profiles keep it in the Keychain.
;;
;; The pool (:db) is for work that can take any connection. Statements the
;; user runs go to a session: a dedicated connection per editor tab, keyed
;; by the session-id the frontend gives the tab, taken on the tab's first
;; run and held until the tab closes. Session state (BEGIN ... COMMIT, SET,
;; temp tables) therefore behaves as in a shell.
;;
;; Sessions come from a second pool, :sessions-db, that keeps no idle
;; connections: closing a session closes its connection instead of parking
;; it, so a closed tab's settings, temp tables or (on SQLite) open
;; transaction never reach whoever takes that connection next.
;;
;; A DuckDB target opens one pool, with no idle connections, and uses it as
;; both :db and :sessions-db. An in-memory DuckDB belongs to the instance
;; that opened it, so a second pool on :memory: would be a second, empty
;; database; with one pool, every tab and the structure tree see the same
;; scratch database. A tab's session is still its own connection, closed
;; with the tab. A file is safe to open twice (two profiles, or Test while
;; connected): the driver keeps one instance per path, process-wide, and a
;; second pool shares it rather than tripping DuckDB's file lock.
;;
;; A closed tab's session-id is retired, and session! refuses it from then
;; on. Bridge calls run concurrently, so a run sent just before the tab
;; closed can reach session! after the close; without the tombstone it
;; would open a session nothing owns. Session ids are frontend UUIDs,
;; never reused; the set goes with its connection.
;;
;; The registry is an atom; the component's value is the atom.
;;
;; Every dial runs under a cancellable shim Ctx: connecting, Test, taking
;; a session. Connect and Test register theirs in ::attempts, an atom of
;; {attempt-id <shim Ctx>} keyed by an id the frontend makes, so
;; cancel-attempt! can stop a dial that would otherwise wait out pgx's
;; connect timeout (10 s per resolved address). A cancel that arrives
;; before its attempt registers finds nothing; the frontend has given the
;; attempt up by then and closes a connection that lands late.

(defn new-id
  "A random UUID as its bare 36-character string. let-go 1.13.0's (str
   (random-uuid)) is the tagged #uuid \"...\" form, which Clojure's is not;
   taking the UUID out of it works either way."
  []
  (let [s (str (random-uuid))]
    (or (re-find #"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" s) s)))

(defn dsn-quote
  "s as a value in a key/value DSN (host='h' port='5432' ...): single-quoted,
   with backslashes and single quotes backslash-escaped, as libpq and pgx
   read it."
  [s]
  (str "'" (-> (str s) (str/replace "\\" "\\\\") (str/replace "'" "\\'")) "'"))

(def ^:private url-re #"(?i)^(postgres|postgresql|redshift)://")

;; The host of a URL: after the scheme and any user:password@, up to the
;; port, path or query. An IPv6 literal's brackets are dropped.
(def ^:private host-re #"(?i)^[a-z]+://(?:[^/?#]*@)?\[?([^/?#:\]]+)")

(def ^:private redshift-hosts [".redshift.amazonaws.com" ".redshift-serverless.amazonaws.com"])

(defn target
  "What `s` names: {:engine :sqlite :path p} for a file path, or
   {:engine :postgres|:redshift :url u} for a URL. A redshift:// URL is
   rewritten to postgres:// for pgx; it, or a Redshift host, makes the
   engine :redshift."
  [s]
  (let [s (str/trim (str s))]
    (when (str/blank? s)
      (throw (ex-info "A file path or postgres:// URL is required." {})))
    (if-let [[_ scheme] (re-find url-re s)]
      (let [host (str/lower-case (or (second (re-find host-re s)) ""))
            redshift? (or (= "redshift" (str/lower-case scheme))
                          (some #(str/ends-with? host %) redshift-hosts))]
        {:engine (if redshift? :redshift :postgres)
         :url (str/replace s url-re "postgres://")})
      {:engine :sqlite :path s})))

(defn label
  "How the UI shows a target: the path, or the URL with its password
   replaced by *** and its query string dropped. The query can carry a
   password too, under names pgx decodes (pass%77ord=...), so none of it
   is shown."
  [{:keys [path url]}]
  (if url
    (-> url
        (str/replace #"[?#].*$" "")
        (str/replace #"^([a-z]+://[^/?#:@]*):[^/?#]*@" "$1:***@"))
    path))

(defn sqlite-uri
  "The SQLite driver's name for the file at path: a file: URI, so a ? or #
   in the path is part of the file name rather than the start of
   parameters. Append ?_pragma=... to configure every connection."
  [path]
  (str "file:"
       (-> path
           (str/replace "%" "%25")
           (str/replace "?" "%3F")
           (str/replace "#" "%23"))))

(defn- dsn-escaped
  "s as it appears inside a quoted DSN value."
  [s]
  (let [q (dsn-quote s)]
    (subs q 1 (dec (count q)))))

(defn redact
  "msg with the target's URL replaced by its label, its :secret masked
   (raw and as escaped in a DSN), and anything else that looks like a
   password (user:password@, password=...) masked: driver errors can quote
   the URL or DSN they failed to use.

   pgx's own parse errors read \"cannot parse `<dsn>`: <reason>\", with the
   password inside half-masked by a regex that does not know about escaped
   quotes, which can leave a piece of it no pattern here matches. For a DSN
   target, the quoted DSN goes first, and only the reason is kept."
  [{:keys [url dsn secret] :as t} msg]
  (cond-> (str msg)
    dsn (str/replace #"cannot parse `(?s:.*)`: " "cannot parse the connection settings: ")
    url (str/replace url (label t))
    (not (str/blank? secret)) (str/replace (dsn-escaped secret) "***")
    (not (str/blank? secret)) (str/replace secret "***")
    true (str/replace #"(?i)(password\s*=\s*)('(?:[^'\\]|\\.)*'|[^\s&'`]+)" "$1***")
    true (str/replace #"([a-z]+://[^/?#:@\s]*):[^/?#@\s]*@" "$1:***@")))

(defn duckdb-path-error
  "Why the DuckDB driver cannot open path as the file it names, or nil.
   The driver reads everything after a ? as options, and url-parses the
   rest, so a % that does not start an escape fails to parse. Other
   characters (#, spaces, a valid %20) open as themselves."
  [path]
  (cond
    (= ":memory:" path) nil
    (str/includes? path "?") "A DuckDB file path cannot contain ?."
    (re-find #"%([^0-9A-Fa-f]|.[^0-9A-Fa-f]|.?$)" path)
    "A DuckDB file path cannot contain a % that is not followed by two hex digits."
    :else nil))

(defn- open-pool
  "A pool for target. Postgres pools keep a session across a cancelled
   query (:postgres/cancel :request). Errors are redacted before they reach
   the UI. Opening is lazy: no connection is made yet."
  [{:keys [engine path url dsn] :as t}]
  (case engine
    :sqlite (sqlite/open (sqlite-uri path))
    :duckdb (do (when-let [msg (duckdb-path-error path)]
                  (throw (ex-info msg {})))
                (try (duckdb/open path)
                     (catch e (throw (ex-info (ex-message e) {})))))
    (try
      (pg/open (or url dsn) {:postgres/cancel :request})
      (catch e (throw (ex-info (redact t (ex-message e)) {}))))))

(defn- close-pool! [engine db]
  (case engine
    :sqlite (sqlite/close! db)
    :duckdb (duckdb/close! db)
    (pg/close! db)))

(defn- ping!
  "Make a connection on db under ctx (a select 1, which works on Postgres,
   Redshift and DuckDB). Throws \"Connecting canceled.\" when ctx was cancelled,
   else the redacted error."
  [t db ctx]
  (try
    (shim/ExecCtx (:sql/handle db) ctx "select 1" [])
    nil
    (catch e
      (if (.Canceled ctx)
        (throw (ex-info "Connecting canceled." {:canceled true}))
        (throw (ex-info (redact t (ex-message e)) {}))))))

(defn- connect
  "The shared pool and the session pool for target. A Postgres pool is
   pinged under ctx, so a wrong password or host fails here, not at the
   first run, and a cancel stops the dial. So is a DuckDB pool, so a file
   that is locked by another process or is not a DuckDB database fails
   here too; it is the one pool for both (see the top of the file)."
  [{:keys [engine] :as t} ctx]
  (let [db (open-pool t)]
    (when (not= :sqlite engine)
      (try (ping! t db ctx)
           (catch e (close-pool! engine db) (throw e))))
    (if (= :duckdb engine)
      (do (.SetMaxIdleConns (:sql/handle db) 0)
          {:db db :sessions-db db})
      (let [sessions-db (try (open-pool t)
                           (catch e (close-pool! engine db) (throw e)))]
        (.SetMaxIdleConns (:sql/handle sessions-db) 0)
        {:db db :sessions-db sessions-db}))))

(defn open-target!
  "Open target t: {:engine (:path | :url | :dsn) :label [:secret]}, where
   :secret is the password a :dsn carries, for redact. Returns
   {:conn-id :engine :label}. Connecting runs under ctx, a shim Ctx; a
   cancel throws \"Connecting canceled.\" and keeps nothing."
  ([registry t] (open-target! registry t (shim/NewCtx)))
  ([registry t ctx]
  (let [id (new-id)
        e (merge (connect t ctx)
                 {:engine (:engine t) :label (:label t) :sessions {} :retired #{}})]
    (swap! registry assoc id e)
    {:conn-id id :engine (:engine e) :label (:label e)})))

(defn open!
  "Open what `s` names (see `target`). Returns {:conn-id :engine :label}."
  [registry s]
  (let [t (target s)]
    (open-target! registry (assoc t :label (label t)))))

(defn check!
  "Connect to target t once and close again; throws the redacted error if
   that fails. Nothing is kept: this backs the Test button. The dial runs
   under ctx, a shim Ctx (a SQLite file is not dialled; a DuckDB one is
   opened, so a file that is not a DuckDB database fails)."
  ([t] (check! t (shim/NewCtx)))
  ([{:keys [engine] :as t} ctx]
   (let [db (open-pool t)]
     (try
       (if (= :sqlite engine)
         (sql/execute! db ["select 1"])
         (ping! t db ctx))
       nil
       (finally (close-pool! engine db))))))

(defn attempt!
  "Call (f ctx) with a fresh shim Ctx, registered under attempt-id (when
   given) so cancel-attempt! can stop it. Deregisters and cancels it when
   f returns. An attempt-id still running is refused."
  [attempts attempt-id f]
  (let [ctx (shim/NewCtx)]
    (when-not (str/blank? attempt-id)
      (let [[old _] (swap-vals! attempts (fn [m] (if (contains? m attempt-id) m (assoc m attempt-id ctx))))]
        (when (contains? old attempt-id)
          (throw (ex-info (str "Attempt " attempt-id " is already running.") {:attempt-id attempt-id})))))
    (try
      (f ctx)
      (finally
        (when-not (str/blank? attempt-id)
          (swap! attempts (fn [m] (if (identical? ctx (get m attempt-id)) (dissoc m attempt-id) m))))
        (.Cancel ctx)))))

(defn cancel-attempt!
  "Cancel the attempt; true if one was running."
  [attempts attempt-id]
  (if-let [ctx (get @attempts attempt-id)]
    (do (.Cancel ctx) true)
    false))

(defn- entry [registry conn-id]
  (or (get @registry conn-id)
      (throw (ex-info (str "No open database " conn-id ".") {:conn-id conn-id}))))

(defn db
  "The pool of an open database, as a sql.core connectable."
  [registry conn-id]
  (:db (entry registry conn-id)))

(defn engine
  "The engine of an open database: :sqlite, :duckdb, :postgres or
   :redshift."
  [registry conn-id]
  (:engine (entry registry conn-id)))

(defn scan-row
  "The row reader for an open database's results: its driver's
   :sql/scan-row (DuckDB's turns dates, decimals, lists and structs into
   plain values), else sql.shim/ScanRow."
  [registry conn-id]
  (or (:sql/scan-row (:db (entry registry conn-id))) shim/ScanRow))

(defn- check-session-id [session-id]
  (when (str/blank? session-id)
    (throw (ex-info "A session id is required." {}))))

(defn session!
  "The tab's session, taken from the session pool on first use. Throws for
   an unknown database or a retired session-id. Taking it dials under ctx,
   a shim Ctx, when one is given, so a cancel stops the dial."
  ([registry conn-id session-id] (session! registry conn-id session-id nil))
  ([registry conn-id session-id ctx]
  (check-session-id session-id)
  (let [e (entry registry conn-id)]
    (when (contains? (:retired e) session-id)
      (throw (ex-info "This tab was closed." {:session-id session-id})))
    (or (get-in e [:sessions session-id])
        (let [handle (:sql/handle (:sessions-db e))
              fresh (if ctx (shim/ConnCtx handle ctx) (shim/Conn handle))
              [_ now] (swap-vals! registry
                                  (fn [m]
                                    (let [cur (get m conn-id)]
                                      (if (and cur
                                               (not (contains? (:retired cur) session-id))
                                               (nil? (get-in cur [:sessions session-id])))
                                        (assoc-in m [conn-id :sessions session-id] fresh)
                                        m))))
              winner (get-in now [conn-id :sessions session-id])]
          ;; Lost a race with another caller, or the database was closed or
          ;; the tab retired meanwhile: give the extra connection back.
          (when-not (identical? winner fresh)
            (.Close fresh))
          (or winner
              (if (contains? (get-in now [conn-id :retired]) session-id)
                (throw (ex-info "This tab was closed." {:session-id session-id}))
                (throw (ex-info (str "No open database " conn-id ".") {:conn-id conn-id})))))))))

(defn current-session
  "The tab's session if one was taken, else nil. Takes none."
  [registry conn-id session-id]
  (get-in @registry [conn-id :sessions session-id]))

(defn reset-session!
  "Drop the tab's session, so the next session! takes a fresh connection.
   For a session whose connection died; closing it is best effort."
  [registry conn-id session-id]
  (let [[old _] (swap-vals! registry
                            (fn [m]
                              (if (contains? m conn-id)
                                (update-in m [conn-id :sessions] dissoc session-id)
                                m)))]
    (when-let [session (get-in old [conn-id :sessions session-id])]
      (.Close session))
    nil))

(defn retire-session!
  "Retire session-id - session! refuses it from now on - and detach its
   session. Returns the detached *sql.Conn, or nil if the tab had none;
   the caller closes it (after cancelling what runs on it: closing a busy
   connection waits for it). An unknown database is a no-op."
  [registry conn-id session-id]
  (check-session-id session-id)
  (let [[old _] (swap-vals! registry
                            (fn [m]
                              (if (contains? m conn-id)
                                (-> m
                                    (update-in [conn-id :sessions] dissoc session-id)
                                    (update-in [conn-id :retired] conj session-id))
                                m)))]
    (get-in old [conn-id :sessions session-id])))

(defn detach!
  "Remove the database's entry, so every later call for it fails with \"No
   open database\". Returns the entry, or nil for an unknown id; the caller
   closes it with close-entry!."
  [registry conn-id]
  (let [[old _] (swap-vals! registry dissoc conn-id)]
    (get old conn-id)))

(defn close-entry!
  "Close a detached entry: its sessions, then its pools (one, for DuckDB)."
  [{:keys [db sessions-db engine sessions]}]
  (doseq [session (vals sessions)]
    (.Close session))
  (when-not (identical? sessions-db db)
    (close-pool! engine sessions-db))
  (close-pool! engine db)
  nil)

(defn close!
  "Close the database: its sessions, then its pools. For callers with no
   queries or cursors on it (quel.exec/close-conn! handles those). Unknown
   ids are a no-op."
  [registry conn-id]
  (when-let [e (detach! registry conn-id)]
    (close-entry! e))
  nil)

(defmethod ig/init-key ::registry [_ _]
  (atom {}))

(defmethod ig/halt-key! ::registry [_ registry]
  (doseq [id (keys @registry)]
    (close! registry id)))

(defmethod ig/init-key ::attempts [_ _]
  (atom {}))

(defmethod ig/halt-key! ::attempts [_ attempts]
  (doseq [ctx (vals @attempts)]
    (.Cancel ctx)))
