(ns quel.menu
  (:refer-clojure :exclude [run!])
  (:require [integrant.core :as ig]
            [wails.core :as w]))

;; The application menu, as data. The menu component's value, {:app ...},
;; is what the click handlers and `spec` take. Every :on-click goes through
;; a var, so a redefinition takes effect on the next click; after editing
;; `spec`, rebuild the menu bar in place:
;;
;;   (quel.menu/install! (:quel.menu/menu @quel.system/system*))
;;
;; The items emit events; the frontend does the work.

(def db-filters
  [["SQLite" "*.db;*.sqlite;*.sqlite3"] ["All files" "*"]])

(defn- reporting
  "Run f; show an error dialog instead of letting a failure vanish into
   stderr, which is where an unawaited menu click's exception goes."
  [app what f]
  (try
    (f)
    (catch e
      (w/message! app :error (str what " failed") (ex-message e)))))

(defn open-db! [{:keys [app]}]
  (reporting app "Open Database"
    (fn []
      (when-let [path (w/open-file app {:title "Open Database"
                                        :filters db-filters})]
        (w/emit! app "menu:open-db" {:path path})))))

(defn- emitter
  "A click handler that emits `event` to the frontend, which does the work."
  [what event]
  (fn [{:keys [app]}]
    (reporting app what (fn [] (w/emit! app event {})))))

(def new-tab! (emitter "New Tab" "menu:new-tab"))
(def new-connection! (emitter "New Connection" "menu:new-connection"))
(def close-tab! (emitter "Close Tab" "menu:close-tab"))
(def reopen-tab! (emitter "Reopen Closed Tab" "menu:reopen-tab"))
(def run! (emitter "Run" "menu:run"))
(def run-script! (emitter "Run Script" "menu:run-script"))
(def cancel! (emitter "Cancel" "menu:cancel"))
(def check-updates! (emitter "Check for Updates" "menu:check-updates"))

;; Cmd+W closes the editor tab: on macOS Wails' window menu has no Close
;; item, so the key is free. If the native menu and the editor's own keymap
;; both see Cmd+Enter, the frontend drops the second run (one in flight
;; per tab). Check for Updates sits in Help: the shim builds the app menu
;; from its role, which takes no items of ours.
(defn spec [env]
  [{:role :app-menu}
   {:label "File"
    :items [{:label "New Tab" :accelerator "CmdOrCtrl+T"
             :on-click (partial #'new-tab! env)}
            {:label "New Connection…"
             :on-click (partial #'new-connection! env)}
            {:label "Open Database…" :accelerator "CmdOrCtrl+O"
             :on-click (partial #'open-db! env)}
            {:separator true}
            {:label "Close Tab" :accelerator "CmdOrCtrl+W"
             :on-click (partial #'close-tab! env)}
            {:label "Reopen Closed Tab" :accelerator "CmdOrCtrl+Shift+T"
             :on-click (partial #'reopen-tab! env)}
            {:separator true}
            {:role :quit}]}
   {:role :edit-menu}
   {:label "Query"
    :items [{:label "Run" :accelerator "CmdOrCtrl+Enter"
             :on-click (partial #'run! env)}
            {:label "Run Script" :accelerator "CmdOrCtrl+Shift+Enter"
             :on-click (partial #'run-script! env)}
            {:separator true}
            {:label "Cancel" :accelerator "CmdOrCtrl+."
             :on-click (partial #'cancel! env)}]}
   {:role :window-menu}
   {:label "Help"
    :items [{:label "Check for Updates…"
             :on-click (partial #'check-updates! env)}]}])

(defn install!
  "Install (or rebuild) the application menu. Returns env."
  [{:keys [app] :as env}]
  (w/set-menu! app (spec env))
  env)

(defmethod ig/init-key ::menu [_ env]
  (install! env))
