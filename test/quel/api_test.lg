(ns quel.api-test
  (:require [integrant.core :as ig]
            [quel.api :as api]
            [quel.conn-test :refer [temp-path with-silent-port ms-since]]
            [quel.export :as export]
            [quel.secrets :as secrets]
            [quel.store-test :refer [temp-dir]]
            [quel.window :as window]
            [string :as str]
            [wails.core :as w]
            [clojure.test :refer [deftest is]]))

;; The handlers as plain fns: what the frontend calls, minus the bridge
;; (the wails package's own tests cover that).

;; Wails keeps one application per process. The window is never run, so
;; zoom and the state checks do nothing to it, as in server mode.
(defonce ^:private window
  (delay (w/new-window (w/new-app {:name "quel-test"}) {:hidden true})))

(defn- with-env [f]
  (let [conns (ig/init-key :quel.conn/registry {})
        attempts (ig/init-key :quel.conn/attempts {})
        execs (ig/init-key :quel.exec/registry {:conns conns})
        dir (temp-dir)
        store (ig/init-key :quel.store/db {:dir dir})
        secrets (ig/init-key :quel.secrets/store {:backend :memory})
        exports (ig/init-key :quel.export/registry {})
        path (temp-path)]
    (try
      ;; :app stays nil: choose-file and export-begin, the handlers that
      ;; need it, open a dialog and are not called here.
      ;; Update checks are off: nothing here reaches GitHub.
      (f {:conns conns :attempts attempts :execs execs :store store :secrets secrets :exports exports :app nil :window @window
          :updates {:enabled? false :store store :version "1.0.0"}}
         path)
      (finally
        (ig/halt-key! :quel.export/registry exports)
        (ig/halt-key! :quel.exec/registry execs)
        (ig/halt-key! :quel.conn/registry conns)
        (ig/halt-key! :quel.conn/attempts attempts)
        (ig/halt-key! :quel.store/db store)
        (os/sh "rm" "-rf" dir)
        (os/sh "rm" "-f" path)))))

(deftest ping-answers
  (is (= {:ok true} (api/ping {}))))

(deftest every-handler-is-a-var
  (is (= #{"ping" "open-db" "close-db" "run" "fetch-page" "cancel" "close-result" "close-session"
           "list-schemas" "describe-schema" "describe-object" "completion-schema"
           "list-profiles" "save-profile" "delete-profile" "test-connection" "connect" "cancel-connect" "choose-file"
           "export-begin" "export-append" "export-finish" "export-abort"
           "load-workspace" "save-workspace" "close-tab" "reopen-tab" "selected-profile" "select-profile" "sidebar-hidden" "set-sidebar-hidden"
           "zoom" "restore-zoom" "save-window-state"
           "check-update" "skip-update" "download-update" "restart-to-update"}
         (set (keys api/handlers))))
  (is (every? var? (vals api/handlers))))

;; export-begin opens a dialog: these start the export behind it.
(deftest an-export-is-written-through-the-handlers
  (with-env
    (fn [{:keys [exports] :as env} _]
      (let [dir (temp-dir)
            target (str dir "/result.csv")
            id (export/begin! exports target)]
        (try
          (api/export-append env id "id\r\n")
          (api/export-append env id "1\r\n")
          (is (= target (api/export-finish env id)))
          (is (= "id\r\n1\r\n" (slurp target)))
          (finally
            (os/sh "rm" "-rf" dir)))))))

(deftest an-aborted-export-leaves-no-file
  (with-env
    (fn [{:keys [exports] :as env} _]
      (let [dir (temp-dir)
            id (export/begin! exports (str dir "/result.csv"))]
        (try
          (api/export-append env id "id\r\n")
          (api/export-abort env id)
          (is (empty? (os/ls dir)))
          (is (empty? @exports))
          (finally
            (os/sh "rm" "-rf" dir)))))))

(deftest zoom-steps-from-the-saved-level-and-keeps-it
  (with-env
    (fn [env _]
      (is (= 1.0 (api/restore-zoom env)))
      (is (= 1.1 (api/zoom env "in")))
      (is (= 1.25 (api/zoom env "in")))
      (is (= 1.1 (api/zoom env "out")))
      (is (= 1.1 (api/restore-zoom env)))
      (is (= 1.0 (api/zoom env "reset")))
      (is (= 1.0 (api/restore-zoom env))))))

(deftest save-window-state-records-a-normal-window
  (with-env
    (fn [env _]
      (window/save-start-state! (:store env) :maximised)
      (is (nil? (api/save-window-state env)))
      (is (= :normal (window/start-state (:store env)))))))

(deftest open-run-close
  (with-env
    (fn [env path]
      (let [{:keys [conn-id] :as opened} (api/open-db env path)]
        (is (= path (:label opened)))
        (let [r (api/run env conn-id "s1" "q1" "select 1 as id, 'a' as name")]
          (is (= #{:columns :rows :has-more :update-count :elapsed-ms} (set (keys r))))
          (is (= [[1 "a"]] (:rows r))))
        (is (nil? (api/close-db env conn-id)))
        (is (empty? @(:conns env)))))))

(deftest structure-of-an-open-database
  (with-env
    (fn [env path]
      (let [{:keys [conn-id]} (api/open-db env path)]
        (api/run env conn-id "s1" "q1" "create table t (id integer, name text)")
        (is (= [{:name "main" :default true}] (api/list-schemas env conn-id)))
        (is (= {:objects [{:name "t" :kind "table"}] :functions [] :types [] :sequences []}
               (api/describe-schema env conn-id "main")))
        (is (= {:columns [{:name "id" :type "INTEGER" :pk false :fk false}
                          {:name "name" :type "TEXT" :pk false :fk false}]
                :indexes [] :keys [] :sequences []}
               (api/describe-object env conn-id "main" "t")))
        (is (= {:default-schema "main" :schemas {"main" {"t" ["id" "name"]}}}
               (api/completion-schema env conn-id)))
        (is (str/includes? (try (api/list-schemas env "nope") "" (catch e (ex-message e)))
                           "No open database"))))))

(deftest cancel-of-an-unknown-query
  (with-env
    (fn [env _]
      (is (= {:canceled false} (api/cancel env "nope"))))))

(deftest page-through-and-close
  (with-env
    (fn [env path]
      (let [{:keys [conn-id]} (api/open-db env path)]
        (api/run env conn-id "s1" "mk" "create table t (id integer)")
        (api/run env conn-id "s1" "fill"
                 (str "insert into t (id) with recursive c(x) as (select 1 union all"
                      " select x + 1 from c where x < 1200) select x from c"))
        (let [r (api/run env conn-id "s1" "big" "select id from t order by id")
              p2 (api/fetch-page env "big")
              p3 (api/fetch-page env "big")]
          (is (true? (:has-more r)))
          (is (= #{:rows :has-more :closed} (set (keys p2))))
          (is (= [500 200] [(count (:rows p2)) (count (:rows p3))]))
          (is (false? (:has-more p3))))
        (api/run env conn-id "s1" "again" "select id from t")
        (is (nil? (api/close-result env "again")))
        (is (true? (:closed (api/fetch-page env "again"))))
        (api/run env conn-id "s2" "other" "select id from t")
        (is (nil? (api/close-session env conn-id "s2")))
        (is (true? (:closed (api/fetch-page env "other"))))
        (api/run env conn-id "s1" "open" "select id from t")
        (is (nil? (api/close-db env conn-id)))
        (is (empty? @(:execs env)))
        (is (empty? @(:conns env)))))))

(defn- message-of [f]
  (try (f) nil (catch e (ex-message e))))

(deftest a-profile-from-save-to-run
  (with-env
    (fn [env path]
      (spit path "")
      (let [form {"name" "Local file" "engine" "sqlite" "path" path "color" "green"}
            p (api/save-profile env form)]
        (is (= [p] (api/list-profiles env)))
        (is (= {:ok true :label "Local file"} (api/test-connection env form)))
        (let [{:keys [conn-id] :as c} (api/connect env (:id p))]
          (is (= {:engine :sqlite :label "Local file" :profile-id (:id p)} (dissoc c :conn-id)))
          (is (= [[1]] (:rows (api/run env conn-id "s1" "q1" "select 1"))))
          (api/close-db env conn-id))
        (is (nil? (api/delete-profile env (:id p))))
        (is (= [] (api/list-profiles env)))
        (is (= "This connection no longer exists." (message-of #(api/connect env (:id p)))))))))

(defn- cancel-when-running
  "On a future: wait for attempt-id to run, then cancel-connect it. Its
   reply, or :never-ran."
  [env attempt-id]
  (future
    (loop [n 0]
      (cond
        (contains? @(:attempts env) attempt-id) (api/cancel-connect env attempt-id)
        (> n 300) :never-ran
        :else (do (sleep 10) (recur (inc n)))))))

(deftest connect-and-test-can-be-cancelled
  (with-silent-port
    (fn [port]
      (with-env
        (fn [env _]
          (let [form {"name" "Silent" "engine" "postgres" "host" "127.0.0.1" "port" (str port)
                      "database" "d" "user" "u" "ssl-mode" "disable"}
                p (api/save-profile env form)]
            (let [t0 (System/nanoTime)
                  c (cancel-when-running env "a1")]
              (is (= "Connecting canceled." (message-of #(api/connect env (:id p) "a1"))))
              (is (= {:canceled true} (deref c 3000 :timeout)))
              (is (< (ms-since t0) 3000))
              (is (empty? @(:conns env)) "nothing kept"))
            (let [t0 (System/nanoTime)
                  c (cancel-when-running env "a2")]
              (is (= "Connecting canceled." (message-of #(api/test-connection env form "a2"))))
              (is (= {:canceled true} (deref c 3000 :timeout)))
              (is (< (ms-since t0) 3000)))
            (is (empty? @(:attempts env)))
            (is (= {:canceled false} (api/cancel-connect env "a1")) "an attempt that ended")))))))

(deftest test-connection-saves-nothing
  (with-env
    (fn [env path]
      (let [missing {"name" "Nope" "engine" "sqlite" "path" (str path ".missing")}]
        (is (str/starts-with? (message-of #(api/test-connection env missing)) "No such file: "))
        (is (= [] (api/list-profiles env)))))))

(deftest a-duplicate-name-is-refused
  (with-env
    (fn [env path]
      (spit path "")
      (api/save-profile env {"name" "One" "engine" "sqlite" "path" path})
      (is (= "A connection named one already exists."
             (message-of #(api/save-profile env {"name" "one" "engine" "sqlite" "path" path})))))))

(deftest no-handler-returns-a-password
  (with-env
    (fn [env _]
      (let [p (api/save-profile env {"name" "W" "engine" "postgres" "host" "h" "password" "s3cret"})]
        (is (not (str/includes? (pr-str p) "s3cret")))
        (is (not (str/includes? (pr-str (api/list-profiles env)) "s3cret")))
        (is (= "s3cret" (secrets/password (:secrets env) (:id p))))))))

(deftest a-workspace-from-save-to-reopen
  (with-env
    (fn [env path]
      (spit path "")
      (let [p (:id (api/save-profile env {"name" "W" "engine" "sqlite" "path" path}))]
        (is (= {:tabs [] :active-tab nil :next-tab-number 1 :closed []} (api/load-workspace env p)))
        (is (nil? (api/save-workspace env p {"tabs" [{"id" "a" "title" "Query 1" "body" "select 1"
                                                       "pinned" true "sel-from" 0 "sel-to" 8}]
                                             "active-tab" "a" "next-tab-number" 2})))
        (let [closed (api/close-tab env p {"id" "b" "title" "Query 2" "body" "select 2"})
              w (api/load-workspace env p)]
          (is (= "select 2" (:body closed)))
          (is (= [{:id "a" :title "Query 1" :body "select 1" :pinned true :sel-from 0 :sel-to 8}] (:tabs w)))
          (is (= ["b"] (mapv :id (:closed w))))
          (let [t (api/reopen-tab env p "b")]
            (is (= "select 2" (:body t)))
            (is (= ["a" (:id t)] (mapv :id (:tabs (api/load-workspace env p)))))))
        (is (nil? (api/selected-profile env)))
        (is (nil? (api/select-profile env p)))
        (is (= p (api/selected-profile env)))
        (is (= "This connection no longer exists."
               (message-of #(api/save-workspace env "nope" {"tabs" []}))))))))

(deftest update-checks-off-and-a-skip
  (with-env
    (fn [env _]
      (is (= {:current "1.0.0" :enabled false} (api/check-update env)))
      (is (= {:ok true} (api/skip-update env "2.0.0"))))))

;; The file chooser's filters follow the engine; the dialog itself needs a
;; window.
(deftest file-filters-follow-the-engine
  (is (str/includes? (second (first (api/db-filters "duckdb"))) "*.duckdb"))
  (is (str/includes? (second (first (api/db-filters "duckdb"))) "*.ddb"))
  (is (str/includes? (second (first (api/db-filters "sqlite"))) "*.sqlite"))
  (is (= (api/db-filters "sqlite") (api/db-filters nil)))
  (is (= ["All files" "*"] (last (api/db-filters "duckdb")))))
