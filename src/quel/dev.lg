(ns quel.dev
  (:require [integrant.core :as ig]
            [nrepl.core :as nrepl]
            [string :as str]
            [wails.core :as w]))

;; The dev loop, on only under `lgx run` (which sets LGX_RUN; a built
;; binary does not): an nREPL inside the app, and the frontend's own loop.
;; Under `lgx dev` the page comes from Vite's dev server
;; (FRONTEND_DEVSERVER_URL), which hot-reloads it; otherwise the window
;; reloads whenever the built frontend changes (`lgx fe-watch` rebuilds it
;; on every edit).

(defn dev?
  "True under `lgx run`. os/getenv returns \"\" (truthy) for an unset
   variable, so the check has to be for a non-blank value."
  []
  (not (str/blank? (os/getenv "LGX_RUN"))))

;; nil outside dev; otherwise the nREPL port and the fn that stops the
;; asset watcher (a no-op under a dev server).
(defmethod ig/init-key ::loop [_ {:keys [window]}]
  (when (dev?)
    (let [dev-server (w/dev-server-url)]
      ;; resources/public is gitignored: a fresh checkout has none until the
      ;; frontend is built, and the window would have nothing to show.
      (when (and (nil? dev-server) (not (:dir? (os/stat "resources/public"))))
        (throw (ex-info (str "resources/public is missing: build the frontend"
                             " first (lgx fe-install && lgx fe-build), or run"
                             " lgx dev.")
                        {})))
      ;; Port 0 picks a free one; editors find it in .nrepl-port.
      (let [port (nrepl/start!)
            stop-watch (if dev-server
                         (do (println (str "dev: frontend from " dev-server " (HMR)"))
                             (fn []))
                         (do (println "dev: reloading the window when resources/public changes")
                             (w/watch-assets! window "resources/public")))]
        {:port port :stop-watch stop-watch}))))

;; Stopping the nREPL removes .nrepl-port.
(defmethod ig/halt-key! ::loop [_ dev]
  (when dev
    ((:stop-watch dev))
    (nrepl/stop!)))
