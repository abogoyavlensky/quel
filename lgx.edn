{:paths ["src"]
 ;; resources/public is the frontend, built by Vite from frontend/ (lgx
 ;; fe-build). `lgx run` serves it from disk (edits show on reload); `lgx
 ;; build` embeds it in the binary.
 :resource-paths ["resources"]
 ;; The entry namespace is quel.app, not main: `lg compile` (the native
 ;; build) rejects a namespace whose last segment is main.
 :main "src/quel/app.lg"

 ;; Wails and the sqlite driver are Go packages, so Quel runs on an lg that
 ;; lgx builds with the Go toolchain.
 :lg-runtime :built
 ;; A let-go main commit: the native build needs `lg compile -module` and
 ;; `-import` (after 1.13.0). Verified with the native build on 2026-10-24.
 :lg-version "18df3ad5c033cbf8f214c7d2a09e97f78a642510"

 ;; `lgx build` compiles Quel to Go (`:target :native`) instead of appending
 ;; bytecode to an lg binary, so the binary can be codesigned; the frontend
 ;; in resources/ is embedded through go:embed. `production` drops Wails'
 ;; devtools and dev asset server from the shipped binary (and the wails
 ;; package's dev-server proxy). It applies to `lgx build` only; `lgx run`
 ;; keeps the dev build.
 :targets {:bin {:target :native :out "bin/quel" :go/build-tags ["production"]}}

 :deps {;; The desktop shell: a Wails v3 window whose handlers are let-go fns.
        abogoyavlensky/letgo-wails
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "wails-v0.6.0"
         :deps/root "wails"}

        ;; An nREPL inside the running app, started only under `lgx run`.
        abogoyavlensky/letgo-nrepl
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "nrepl-v0.1.0"
         :deps/root "nrepl"}

        ;; SQLite over Go's database/sql; brings the sql layer (sessions,
        ;; cancellation) and the modernc.org/sqlite driver in transitively.
        ;; sqlite-v0.3.0 is the first with sql-v0.3.0's context support.
        abogoyavlensky/letgo-sqlite
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "sqlite-v0.3.0"
         :deps/root "sqlite"}

        ;; Postgres (and Redshift, which speaks its protocol) through pgx.
        ;; postgres-v0.4.0 is the first whose pools can keep a session
        ;; alive across a cancelled query (:postgres/cancel :request).
        abogoyavlensky/letgo-postgres
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "postgres-v0.4.0"
         :deps/root "postgres"}

        ;; Profile passwords in the macOS Keychain (the Secret Service on
        ;; Linux), over go-keyring. keyring-v0.1.0 is the first release.
        abogoyavlensky/letgo-keyring
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "keyring-v0.1.0"
         :deps/root "keyring"}

        ;; Migrations for the app database (profiles, later history and
        ;; the workspace). It names sql-v0.3.0, the tag sqlite and postgres
        ;; name, so the three resolve to one checkout.
        abogoyavlensky/letgo-ragtime
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "ragtime-v0.3.0"
         :deps/root "ragtime"}

        ;; integrant wires the registries, the handlers, the window, the
        ;; menu and the dev loop together. It depends on
        ;; weavejester/dependency; lgx does not read a plain Clojure lib's
        ;; deps.edn transitively yet, so both are listed.
        dev.weavejester/dependency
        {:git/url "https://github.com/weavejester/dependency"
         :git/tag "1.0.1"}
        dev.weavejester/integrant
        {:git/url "https://github.com/weavejester/integrant"
         :git/tag "1.0.1"}}

 :tasks
 {dev {:doc "Run the app with the frontend from Vite's dev server (HMR)"
       :do {:sh "bash scripts/dev.sh"}}
  fe-install {:doc "Install the frontend's npm packages"
              :do {:sh "npm --prefix frontend ci"}}
  fe-build {:doc "Build the frontend into resources/public"
            :do {:sh "npm --prefix frontend run build"}}
  fe-watch {:doc "Rebuild the frontend on every change (the window reloads under lgx run)"
            :do {:sh "npm --prefix frontend run watch"}}
  build {:doc "Build the frontend, then the binary"
         :do [{:task fe-build} {:task lgx:build}]}
  test-pg {:doc "Run the backend tests with a throwaway Postgres in Docker"
           :do {:sh "bash scripts/with-postgres.sh lgx test"}}
  e2e {:doc "Run the Playwright UI tests against the app in server mode"
       :do {:sh "bash scripts/e2e.sh"}}
  smoke {:doc "Run the app in server mode and drive the bridge over HTTP"
         :do {:sh "bash scripts/smoke.sh"}}
  smoke-pg {:doc "The smoke test, plus Postgres, with a throwaway one in Docker"
            :do {:sh "bash scripts/with-postgres.sh bash scripts/smoke.sh"}}
  package-macos {:doc "Build dist/Quel.app (unsigned) on an Apple Silicon Mac"
                 :do {:sh "bash scripts/package-macos.sh"}}
  verify-macos {:doc "Check dist/Quel.app and launch an ad-hoc signed copy; --distribution checks the signed release archive"
                :do {:sh ["bash" "scripts/verify-macos.sh" :args/rest]}}
  sign-macos {:doc "Sign with Developer ID, notarize and archive dist/Quel.app (APPLE_SIGNING_IDENTITY, APPLE_NOTARY_PROFILE)"
              :do {:sh "bash scripts/sign-macos.sh"}}
  test-release {:doc "Test the release scripts with stand-ins for Apple's tools and GitHub"
                :do {:sh "bash scripts/test-release.sh"}}}}
