(ns quel.secrets
  (:require [integrant.core :as ig]
            [keyring.core :as kr]))

;; Profile passwords, in the macOS Keychain (the Secret Service on Linux):
;; one item per profile, under the service "Quel" with the profile's id as
;; its account. Never in the app database, never sent to the frontend.
;;
;; The :memory backend swaps the keyring for an in-memory one, process-wide
;; (keyring.core/use-memory!): tests, smoke and e2e use it, so they never
;; touch a real Keychain, and the Linux CI box has no Secret Service.
;;
;; The component's value is {:service "Quel" :backend b}.

(def service "Quel")

(defn password
  "The saved password of profile id, or nil."
  [{:keys [service]} id]
  (kr/get service id))

(defn set-password!
  "Save pw as profile id's password, replacing any saved one."
  [{:keys [service]} id pw]
  (kr/put! service id pw))

(defn delete-password!
  "Remove profile id's saved password, if it has one."
  [{:keys [service]} id]
  (kr/delete! service id))

(defmethod ig/init-key ::store [_ {:keys [backend]}]
  (when (= :memory backend)
    (kr/use-memory!))
  {:service service :backend backend})
