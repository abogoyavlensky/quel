(ns quel.meta-test
  (:require [quel.conn :as conn]
            [quel.conn-test :refer [with-registry]]
            [quel.meta :as meta]
            [quel.meta.duckdb]
            [quel.meta.sqlite]
            [sql.core :as sql]
            [clojure.test :refer [deftest is]]))

;; SQLite introspection over a throwaway file.

(defn- with-db
  "Run (f db) over a SQLite file holding a few tables and views."
  [f]
  (with-registry
    (fn [registry path]
      (let [{:keys [conn-id]} (conn/open! registry path)
            db (conn/db registry conn-id)]
        (doseq [q ["create table t (id integer primary key, name text)"
                   "create view v as select name from t"
                   "create virtual table docs using fts5(body)"
                   "create table \"it's a table\" (x int)"
                   "create table g (a int, b int generated always as (a * 2) virtual)"
                   "create table gone (x int)"
                   "create view broken as select x from gone"
                   "drop table gone"
                   "create table child (id integer primary key, t_id int references t(id), code text unique, n int)"
                   "create index child_n on child (n)"
                   "create index child_expr on child (n + 1)"
                   "create index child_partial on child (code) where n > 0"
                   "create table pair (a int, b int, t_ref int references t, primary key (a, b))"]]
          (sql/execute! db [q]))
        (f db)))))

(deftest sqlite-schemas-leave-out-temp
  (with-db
    (fn [db]
      (is (= [{:name "main" :default true}] (meta/schemas :sqlite db))))))

(deftest sqlite-objects
  (with-db
    (fn [db]
      (is (= [{:name "broken" :kind "view"}
              {:name "child" :kind "table"}
              {:name "docs" :kind "table"}
              {:name "g" :kind "table"}
              {:name "it's a table" :kind "table"}
              {:name "pair" :kind "table"}
              {:name "t" :kind "table"}
              {:name "v" :kind "view"}]
             (meta/objects :sqlite db "main"))))))

(deftest sqlite-columns
  (with-db
    (fn [db]
      (is (= [{:name "id" :type "INTEGER"} {:name "name" :type "TEXT"}]
             (meta/columns :sqlite db "main" "t")))
      (is (= ["a" "b"] (mapv :name (meta/columns :sqlite db "main" "g"))) "generated columns too")
      (is (= ["body"] (mapv :name (meta/columns :sqlite db "main" "docs"))) "no FTS hidden columns")
      (is (= [{:name "x" :type "INT"}] (meta/columns :sqlite db "main" "it's a table")))
      (is (= [] (meta/columns :sqlite db "main" "nope"))))))

(deftest sqlite-completion-survives-a-broken-view
  (with-db
    (fn [db]
      (let [c (meta/completion-schema :sqlite db)]
        (is (= "main" (:default-schema c)))
        (is (= ["id" "name"] (get-in c [:schemas "main" "t"])))
        (is (= ["name"] (get-in c [:schemas "main" "v"])))
        (is (= ["x"] (get-in c [:schemas "main" "it's a table"])))
        (is (not (contains? (get-in c [:schemas "main"]) "broken")))))))

(deftest sqlite-describe-schema
  (with-db
    (fn [db]
      (let [d (meta/describe-schema :sqlite db "main")]
        (is (= (meta/objects :sqlite db "main") (:objects d)))
        (is (= {:functions [] :types [] :sequences []} (dissoc d :objects)))))))

(deftest sqlite-describe-object
  (with-db
    (fn [db]
      (let [d (meta/describe-object :sqlite db "main" "t")]
        (is (= ["id" "name"] (mapv :name (:columns d))))
        (is (every? #(contains? % :pk) (:columns d)))
        (is (every? #(contains? % :fk) (:columns d)))
        (is (every? vector? [(:indexes d) (:keys d) (:sequences d)]))))))

(deftest sqlite-indexes
  (with-db
    (fn [db]
      (is (= [{:name "child_expr" :definition "(<expr>)" :unique false :primary false}
              {:name "child_n" :definition "(n)" :unique false :primary false}
              {:name "child_partial" :definition "(code) partial" :unique false :primary false}
              {:name "sqlite_autoindex_child_1" :definition "(code)" :unique true :primary false}]
             (meta/indexes :sqlite db "main" "child")))
      (is (= [{:name "sqlite_autoindex_pair_1" :definition "(a, b)" :unique true :primary true}]
             (meta/indexes :sqlite db "main" "pair")))
      (is (= [] (meta/indexes :sqlite db "main" "t")) "a rowid primary key has no index")
      (is (= [] (meta/indexes :sqlite db "main" "nope"))))))

(deftest sqlite-constraints
  (with-db
    (fn [db]
      (is (= [{:name nil :kind "primary-key" :columns ["id"] :definition "PRIMARY KEY (id)"}
              {:name nil :kind "unique" :columns ["code"] :definition "UNIQUE (code)"}
              {:name nil :kind "foreign-key" :columns ["t_id"] :definition "FOREIGN KEY (t_id) REFERENCES t(id)"}]
             (meta/constraints :sqlite db "main" "child")))
      (is (= [{:name nil :kind "primary-key" :columns ["a" "b"] :definition "PRIMARY KEY (a, b)"}
              {:name nil :kind "foreign-key" :columns ["t_ref"] :definition "FOREIGN KEY (t_ref) REFERENCES t"}]
             (meta/constraints :sqlite db "main" "pair")))
      (is (= [] (meta/constraints :sqlite db "main" "v")))
      (is (= [] (meta/constraints :sqlite db "main" "nope"))))))

(deftest sqlite-describe-object-marks-keys
  (with-db
    (fn [db]
      (let [cols (:columns (meta/describe-object :sqlite db "main" "child"))
            by (into {} (map (juxt :name identity) cols))]
        (is (= [true false] ((juxt :pk :fk) (by "id"))))
        (is (= [false true] ((juxt :pk :fk) (by "t_id"))))
        (is (= [false false] ((juxt :pk :fk) (by "code"))))))))

;; DuckDB introspection over an in-memory database.

(defn- with-duck
  "Run (f db) over an in-memory DuckDB holding one of everything."
  [f]
  (with-registry
    (fn [registry _]
      (let [{:keys [conn-id]} (conn/open-target! registry {:engine :duckdb :path ":memory:" :label "m"})
            db (conn/db registry conn-id)]
        (doseq [q ["create schema s2"
                   "create type mood as enum ('sad', 'ok', 'happy')"
                   "create sequence seq1 start 1"
                   "create table p (id integer primary key, name varchar)"
                   "create table t (id integer primary key, code varchar unique, pid integer references p(id), n integer check (n > 0), m mood)"
                   "create index t_n on t (n)"
                   "create view v as select id, code from t"
                   "create macro add2(a, b) as a + b"
                   "create macro tm(x) as table select x as y"
                   "create table s2.u (a integer)"]]
          (sql/execute! db [q]))
        ;; A temp table, on the pool: it must not show.
        (sql/execute! db ["create temp table tmp1 (a integer)"])
        (f db)))))

(deftest duckdb-schemas
  (with-duck
    (fn [db]
      (is (= [{:name "main" :default true} {:name "s2" :default false}]
             (meta/schemas :duckdb db))))))

(deftest duckdb-objects
  (with-duck
    (fn [db]
      (is (= [{:name "p" :kind "table"} {:name "t" :kind "table"} {:name "v" :kind "view"}]
             (meta/objects :duckdb db "main")))
      (is (= [{:name "u" :kind "table"}] (meta/objects :duckdb db "s2"))))))

(deftest duckdb-columns
  (with-duck
    (fn [db]
      (is (= [{:name "id" :type "INTEGER"} {:name "code" :type "VARCHAR"} {:name "pid" :type "INTEGER"}
              {:name "n" :type "INTEGER"} {:name "m" :type "ENUM('sad', 'ok', 'happy')"}]
             (meta/columns :duckdb db "main" "t")))
      (is (= ["id" "code"] (mapv :name (meta/columns :duckdb db "main" "v"))))
      (is (= [] (meta/columns :duckdb db "main" "nope")))
      (is (= [] (meta/columns :duckdb db "main" "tmp1"))))))

(deftest duckdb-completion
  (with-duck
    (fn [db]
      (let [c (meta/completion-schema :duckdb db)]
        (is (= "main" (:default-schema c)))
        (is (= ["id" "code" "pid" "n" "m"] (get-in c [:schemas "main" "t"])))
        (is (= ["id" "code"] (get-in c [:schemas "main" "v"])))
        (is (= ["a"] (get-in c [:schemas "s2" "u"])))
        (is (= #{"main" "s2"} (set (keys (:schemas c)))))))))

(deftest duckdb-describe-schema
  (with-duck
    (fn [db]
      (let [d (meta/describe-schema :duckdb db "main")]
        (is (= (meta/objects :duckdb db "main") (:objects d)))
        (is (= [{:name "add2" :kind "function" :args "a, b"} {:name "tm" :kind "function" :args "x"}]
               (:functions d)))
        (is (= [{:name "mood" :kind "enum" :detail nil :values ["sad" "ok" "happy"]}] (:types d)))
        (is (= [{:name "seq1"}] (:sequences d)))
        (is (= {:objects [{:name "u" :kind "table"}] :functions [] :types [] :sequences []}
               (meta/describe-schema :duckdb db "s2")))))))

(deftest duckdb-indexes
  (with-duck
    (fn [db]
      (is (= [{:name "t_n" :definition "(n)" :unique false :primary false}]
             (meta/indexes :duckdb db "main" "t")))
      (is (= [] (meta/indexes :duckdb db "main" "p"))))))

(deftest duckdb-constraints
  (with-duck
    (fn [db]
      (is (= [{:name "t_id_pkey" :kind "primary-key" :columns ["id"] :definition "PRIMARY KEY(id)"}
              {:name "t_code_key" :kind "unique" :columns ["code"] :definition "UNIQUE(code)"}
              {:name "t_pid_id_fkey" :kind "foreign-key" :columns ["pid"] :definition "FOREIGN KEY (pid) REFERENCES p(id)"}
              {:name "t_n_check" :kind "check" :columns ["n"] :definition "CHECK((n > 0))"}]
             (meta/constraints :duckdb db "main" "t")))
      (is (= ["primary-key"] (mapv :kind (meta/constraints :duckdb db "main" "p")))
          "a referenced table lists only its own keys")
      (is (= [] (meta/constraints :duckdb db "main" "v"))))))

(deftest duckdb-describe-object-marks-keys
  (with-duck
    (fn [db]
      (let [d (meta/describe-object :duckdb db "main" "t")
            by (into {} (map (juxt :name identity) (:columns d)))]
        (is (= [true false] ((juxt :pk :fk) (by "id"))))
        (is (= [false true] ((juxt :pk :fk) (by "pid"))))
        (is (= [false false] ((juxt :pk :fk) (by "code"))))
        (is (= [] (:sequences d)))))))
