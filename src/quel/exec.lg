(ns quel.exec
  (:refer-clojure :exclude [run!])
  (:require [integrant.core :as ig]
            [quel.cells :as cells]
            [quel.conn :as conn]
            [sql.core :as sql]
            [sql.shim :as shim]
            [string :as str]))

;; Running queries, keyed by a query-id the frontend generates, so it can
;; cancel a query before its first row arrives. Each entry is
;; {:ctx <shim Ctx> :conn-id <string>}; an entry lives exactly as long as
;; its query runs.
;;
;; Milestone 0 returns the first page and closes the cursor. fetch-page and
;; cursor lifetime (idle timeout, close on tab close) are milestone 1.
;;
;; The registry is an atom; the component's value is the atom.

(def default-page-size 500)

(defn- register!
  "Add the query's entry, refusing a reused query-id and a second query on
   a connection: one session cannot run two statements at once."
  [execs query-id conn-id ctx]
  (let [[old _] (swap-vals! execs
                            (fn [m]
                              (if (or (contains? m query-id)
                                      (some #(= conn-id (:conn-id %)) (vals m)))
                                m
                                (assoc m query-id {:ctx ctx :conn-id conn-id}))))]
    (cond
      (contains? old query-id)
      (throw (ex-info (str "Query " query-id " is already running.") {:query-id query-id}))

      (some #(= conn-id (:conn-id %)) (vals old))
      (throw (ex-info "A query is already running on this connection." {:conn-id conn-id})))))

(defn- fail-on-err!
  "(.Next rows) is false both at the end and on a failed read, so the
   cursor's error decides which it was."
  [rows]
  (when-let [err (.Err rows)]
    (throw (ex-info (.Error err) {}))))

(defn read-page
  "Read up to n rows from an open cursor as encoded cells. Returns
   {:rows [...] :has-more bool}; has-more consumes one row to find out."
  [rows n]
  (loop [acc []]
    (if (< (count acc) n)
      (if (.Next rows)
        (recur (conj acc (cells/encode-row (vec (shim/ScanRow rows)))))
        (do (fail-on-err! rows)
            {:rows acc :has-more false}))
      (let [more (.Next rows)]
        (when-not more (fail-on-err! rows))
        {:rows acc :has-more more}))))

(defn- run-rows [session ctx q page-size]
  (let [rows (shim/QueryCtx session ctx q [])]
    (try
      (let [names (vec (.Columns rows))
            types (vec (shim/ColumnTypeNames rows))
            page (read-page rows page-size)]
        {:columns (mapv (fn [n t] {:name n :type t}) names types)
         :rows (:rows page)
         :has-more (:has-more page)
         :update-count nil})
      (finally (.Close rows)))))

(defn- run-exec [session ctx q]
  {:columns []
   :rows []
   :has-more false
   :update-count (.RowsAffected (shim/ExecCtx session ctx q []))})

(defn run!
  "Run one statement on the connection's session. Returns
   {:columns [{:name :type}] :rows [[cell ...]] :has-more :update-count
    :elapsed-ms}. A cancelled query throws \"Query canceled.\"."
  [execs conns {:keys [conn-id query-id sql page-size]
                :or {page-size default-page-size}}]
  (when (str/blank? query-id)
    (throw (ex-info "A query id is required." {})))
  (when (str/blank? sql)
    (throw (ex-info "Nothing to run." {})))
  (let [ctx (shim/NewCtx)]
    (register! execs query-id conn-id ctx)
    (try
      (let [session (conn/session! conns conn-id)
            t0 (System/nanoTime)
            result (if (sql/returns-rows? sql)
                     (run-rows session ctx sql page-size)
                     (run-exec session ctx sql))]
        (assoc result :elapsed-ms (quot (- (System/nanoTime) t0) 1000000)))
      (catch e
        (if (.Canceled ctx)
          (throw (ex-info "Query canceled." {:query-id query-id}))
          (throw e)))
      (finally
        (.Cancel ctx)
        (swap! execs dissoc query-id)))))

(defn cancel!
  "Cancel a running query. True if it was running, false if the id is
   unknown (never started, or already finished)."
  [execs query-id]
  (if-let [{:keys [ctx]} (get @execs query-id)]
    (do (.Cancel ctx) true)
    false))

;; :conns is unused here but makes this component depend on the connection
;; registry, so integrant halts it first: running queries are cancelled
;; before their sessions close (closing a busy session waits for it).
(defmethod ig/init-key ::registry [_ _]
  (atom {}))

(defmethod ig/halt-key! ::registry [_ execs]
  (doseq [id (keys @execs)]
    (cancel! execs id))
  ;; Give the cancelled queries a moment to unwind and deregister.
  (loop [waited 0]
    (when (and (seq @execs) (< waited 5000))
      (sleep 50)
      (recur (+ waited 50)))))
