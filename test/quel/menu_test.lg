(ns quel.menu-test
  (:require [quel.menu :as menu]
            [wails.core :as w]
            [clojure.test :refer [deftest is]]))

;; check-menu builds the spec with Wails, which needs the application to
;; exist; nothing is run or shown.
(defonce ^:private app (delay (w/new-app {:name "quel-test"})))

(defn- on-clicks [items]
  (mapcat (fn [item]
            (concat (when (contains? item :on-click) [(:on-click item)])
                    (on-clicks (:items item))))
          items))

(deftest the-spec-is-data
  (is (vector? (menu/spec {:app nil}))))

(defn- labels [items]
  (mapcat (fn [item] (cons (:label item) (labels (:items item)))) items))

(deftest every-item-with-a-click-has-one
  (is (= 15 (count (on-clicks (menu/spec {:app nil} "darwin")))))
  (is (= 15 (count (on-clicks (menu/spec {:app nil} "linux"))))))

(deftest the-tab-and-query-items-are-there
  (is (every? (set (labels (menu/spec {:app nil})))
              ["New Tab" "New Connection…" "Close Tab" "Reopen Closed Tab" "Query" "Run" "Run Script" "Cancel"
               "Check for Updates…" "View" "Command Palette…" "Go to Connection…"
               "Zoom In" "Zoom Out" "Actual Size"])))

(deftest wails-accepts-the-spec
  @app
  (is (true? (w/check-menu (menu/spec {:app nil}))))
  (is (true? (w/check-menu (menu/spec {:app nil} "darwin"))))
  (is (true? (w/check-menu (menu/spec {:app nil} "linux")))))

(defn- roles [items] (set (keep :role items)))

(deftest the-app-menu-is-quels-own
  (doseq [os ["darwin" "linux"]]
    (let [[app-menu & more] (menu/spec {:app nil} os)
          item (fn [label] (first (filter #(= label (:label %)) (:items app-menu))))]
      (is (= "Quel" (:label app-menu)))
      (is (some? (:on-click (item "About Quel…"))))
      (is (some? (:on-click (item "Check for Updates…"))))
      (is (= "CmdOrCtrl+," (:accelerator (item "Settings…"))))
      (is (contains? (roles (:items app-menu)) :quit))
      (is (not-any? #(= "Help" (:label %)) more))
      (is (not (contains? (roles (:items (first (filter #(= "File" (:label %)) more)))) :quit))))))

(deftest the-macos-roles-are-on-macos-only
  (let [mac-only #{:services-menu :hide :hide-others :show-all}
        app-roles (fn [os] (roles (:items (first (menu/spec {:app nil} os)))))]
    (is (every? (app-roles "darwin") mac-only))
    (is (not-any? (app-roles "linux") mac-only))))

(deftest reopen-closed-tab-has-its-key
  (let [item (->> (menu/spec {:app nil}) (mapcat :items) (filter #(= "Reopen Closed Tab" (:label %))) first)]
    (is (= "CmdOrCtrl+Shift+T" (:accelerator item)))))

(deftest the-palettes-have-their-keys
  (let [item (fn [label] (->> (menu/spec {:app nil}) (mapcat :items) (filter #(= label (:label %))) first))]
    (is (= "CmdOrCtrl+Shift+P" (:accelerator (item "Command Palette…"))))
    (is (= "CmdOrCtrl+P" (:accelerator (item "Go to Connection…"))))))

(deftest the-zoom-items-have-their-keys
  (let [item (fn [label] (->> (menu/spec {:app nil}) (mapcat :items) (filter #(= label (:label %))) first))]
    (is (= "CmdOrCtrl+=" (:accelerator (item "Zoom In"))))
    (is (= "CmdOrCtrl+-" (:accelerator (item "Zoom Out"))))
    (is (= "CmdOrCtrl+0" (:accelerator (item "Actual Size"))))))
