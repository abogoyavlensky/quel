(ns quel.cells-test
  (:require [quel.cells :as cells]
            [clojure.test :refer [deftest is]]))

(deftest plain-values-pass-through
  (is (nil? (cells/encode nil)))
  (is (true? (cells/encode true)))
  (is (false? (cells/encode false)))
  (is (= 1.5 (cells/encode 1.5)))
  (is (= "x" (cells/encode "x")))
  (is (= 42 (cells/encode 42))))

(deftest safe-integers-stay-numbers
  (is (= 9007199254740991 (cells/encode 9007199254740991)))
  (is (= -9007199254740991 (cells/encode -9007199254740991))))

;; JavaScript numbers are doubles: past 2^53 - 1 they round.
(deftest unsafe-integers-become-strings
  (is (= "9007199254740992" (cells/encode 9007199254740992)))
  (is (= "-9007199254740992" (cells/encode -9007199254740992)))
  (is (= "9223372036854775807" (cells/encode 9223372036854775807))))

;; Go's JSON encoder rejects these, so they cross as strings.
(deftest non-finite-floats-become-strings
  (let [inf (* 1e308 10.0)]
    (is (= "Infinity" (cells/encode inf)))
    (is (= "-Infinity" (cells/encode (- inf))))
    (is (= "NaN" (cells/encode (- inf inf))))
    (is (= 1.7976931348623157e308 (cells/encode 1.7976931348623157e308)))))

(deftest anything-else-is-its-string-form
  (is (= ":k" (cells/encode :k)))
  (is (= "(1 2)" (cells/encode '(1 2)))))

(deftest encode-row-maps-over-a-row
  (let [row (cells/encode-row [1 nil 9007199254740992 "a"])]
    (is (vector? row))
    (is (= [1 nil "9007199254740992" "a"] row))))

(deftest typed-strings-pass-through
  ;; SQLite stores dates as text, whatever the declared type.
  (is (= "2026-10-21" (cells/encode "DATE" "2026-10-21")))
  (is (= "2026-10-21 10:00:00" (cells/encode "TIMESTAMP" "2026-10-21 10:00:00")))
  (is (= "1.50" (cells/encode "NUMERIC" "1.50"))))

(deftest binary-columns-become-hex
  (is (= "\\x4142" (cells/encode "BYTEA" "AB")))
  (is (= "\\x4142" (cells/encode "BLOB" "AB")))
  (is (= "\\x4142" (cells/encode "blob" "AB")) "the type name's case does not matter")
  (is (= "\\x" (cells/encode "BYTEA" "")))
  (is (nil? (cells/encode "BYTEA" nil)) "NULL stays NULL"))

;; SQLite lets a BLOB column hold any value.
(deftest only-strings-in-binary-columns-are-hex
  (is (= 42 (cells/encode "BLOB" 42)))
  (is (= 1.5 (cells/encode "BLOB" 1.5))))

(deftest large-binary-values-show-their-size
  (let [at-cap (apply str (repeat 65536 "a"))]
    (is (= (str "\\x" (apply str (repeat 65536 "61"))) (cells/encode "BYTEA" at-cap)))
    (is (= "(binary, 65537 bytes)" (cells/encode "BYTEA" (str at-cap "a"))))))

(deftest typed-rows-line-up-with-their-types
  (is (= [1 "\\x78" nil] (cells/encode-row ["INT4" "BYTEA" "TEXT"] [1 "x" nil]))))

;; pgx reports a type outside its type map as its OID.
(deftest type-names-name-redshift-super
  (is (= ["INT4" "SUPER" "TEXT"] (cells/type-names :redshift ["INT4" "4000" "TEXT"])))
  (is (= ["4000"] (cells/type-names :postgres ["4000"])))
  (is (= ["4000"] (cells/type-names :sqlite ["4000"])))
  (is (= ["3000"] (cells/type-names :redshift ["3000"])))
  (is (= [] (cells/type-names :redshift [])))
  (is (vector? (cells/type-names :redshift (list "4000")))))

;; DuckDB values, as duckdb.shim/ScanRow hands them over.

(deftest duckdb-lists-and-structs-become-json
  (is (= "[1,2]" (cells/encode "INTEGER[]" [1 2])))
  (is (= "{\"a\":1}" (cells/encode "STRUCT(a INTEGER)" {:a 1})))
  (is (= "{\"k\":[\"x\",null]}" (cells/encode "MAP(VARCHAR, VARCHAR[])" {"k" ["x" nil]})))
  (is (= "[]" (cells/encode "INTEGER[]" []))))

;; As DuckDB prints them (select interval '...'::varchar).
(deftest duckdb-intervals-print-as-duckdb-prints-them
  (let [iv (fn [m d us] (cells/encode "INTERVAL" {:months m :days d :micros us}))]
    (is (= "1 year 2 months 3 days 01:30:00" (iv 14 3 5400000000)))
    (is (= "00:00:00" (iv 0 0 0)))
    (is (= "1 day" (iv 0 1 0)))
    (is (= "-1 day" (iv 0 -1 0)))
    (is (= "-01:30:00" (iv 0 0 -5400000000)))
    (is (= "-1 year -2 months" (iv -14 0 0)))
    (is (= "-1 day 02:00:00" (iv 0 -1 7200000000)))
    (is (= "00:00:01.5" (iv 0 0 1500000)))
    (is (= "2 years" (iv 24 0 0)))
    (is (= "25:00:00" (iv 0 0 90000000000)))))
