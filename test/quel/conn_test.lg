(ns quel.conn-test
  (:require [integrant.core :as ig]
            [postgres.core :as pg]
            [quel.conn :as conn]
            [sql.core :as sql]
            [sql.shim :as shim]
            [string :as str]
            [clojure.test :refer [deftest is]]))

(defn temp-path []
  (str "/tmp/quel-test-" (random-uuid) ".db"))

(defn with-registry
  "Run (f registry path) over a fresh registry and a throwaway file path,
   closing everything afterwards."
  [f]
  (let [registry (ig/init-key :quel.conn/registry {})
        path (temp-path)]
    (try
      (f registry path)
      (finally
        (ig/halt-key! :quel.conn/registry registry)
        (os/sh "rm" "-f" path)))))

(defn- message-of [f]
  (try (f) nil (catch e (ex-message e))))

(defn- thrown-of [f]
  (try (f) nil (catch e e)))

(defn with-silent-port
  "Run (f port) with a TCP port on 127.0.0.1 that takes connections and
   never answers: the kernel completes the handshake and nothing accepts,
   so a Postgres dial waits for the server's reply until its timeout."
  [f]
  (let [l (net/listen "127.0.0.1" 0)]
    (try
      (f (:port (net/local-address l)))
      (finally (net/close! l)))))

(defn silent-dsn
  "A DSN for the silent port that only a cancel ends soon."
  ([port] (silent-dsn port 30))
  ([port timeout-s]
   (str "host='127.0.0.1' port='" port "' user='u' dbname='d' sslmode='disable'"
        " connect_timeout='" timeout-s "'")))

(defn ms-since [t0]
  (quot (- (System/nanoTime) t0) 1000000))

(defn cancel-after
  "Cancel the shim Ctx ctx after ms, on a future."
  [ms ctx]
  (future (sleep ms) (.Cancel ctx)))

(deftest open-returns-an-id-the-engine-and-a-label
  (with-registry
    (fn [registry path]
      (let [{:keys [conn-id] :as r} (conn/open! registry path)]
        (is (re-matches #"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" conn-id))
        (is (= :sqlite (:engine r)))
        (is (= path (:label r)))
        (is (contains? @registry conn-id))))))

(deftest a-blank-path-is-refused
  (with-registry
    (fn [registry _]
      (is (str/includes? (message-of #(conn/open! registry "  ")) "is required")))))

(deftest a-session-is-taken-once-per-id-and-keeps-state
  (with-registry
    (fn [registry path]
      (let [{:keys [conn-id]} (conn/open! registry path)
            s1 (conn/session! registry conn-id "a")
            s2 (conn/session! registry conn-id "a")]
        (is (identical? s1 s2))
        (sql/execute! {:sql/handle s1} ["create temp table t (x integer)"])
        (sql/execute! {:sql/handle s2} ["insert into t (x) values (1)"])
        (is (= [{:x 1}] (sql/execute! {:sql/handle s1} ["select x from t"])))))))

(deftest each-tab-has-its-own-session
  (with-registry
    (fn [registry path]
      (let [{:keys [conn-id]} (conn/open! registry path)
            a (conn/session! registry conn-id "a")
            b (conn/session! registry conn-id "b")]
        (is (not (identical? a b)))
        (sql/execute! {:sql/handle a} ["create temp table only_a (x integer)"])
        (is (str/includes? (str (message-of #(sql/execute! {:sql/handle b} ["select x from only_a"])))
                           "no such table"))))))

(deftest a-session-id-is-required
  (with-registry
    (fn [registry path]
      (let [{:keys [conn-id]} (conn/open! registry path)]
        (is (str/includes? (str (message-of #(conn/session! registry conn-id " ")))
                           "session id is required"))))))

(defn- open-conns
  "The session pool's open connections, read from its DBStats (a struct
   let-go prints as {MaxOpen Open InUse Idle ...})."
  [registry conn-id]
  (let [stats (str (.Stats (:sql/handle (:sessions-db (get @registry conn-id)))))]
    (parse-long (second (re-find #"\{\d+ (\d+) " stats)))))

(deftest a-retired-session-is-closed-for-good
  (with-registry
    (fn [registry path]
      (let [{:keys [conn-id]} (conn/open! registry path)
            a (conn/session! registry conn-id "a")]
        (sql/execute! {:sql/handle a} ["create temp table t (x integer)"])
        (is (= 1 (open-conns registry conn-id)))
        (let [detached (conn/retire-session! registry conn-id "a")]
          (is (identical? a detached))
          (.Close detached))
        (is (= 0 (open-conns registry conn-id))
            "the connection is closed, not parked in the pool")
        (is (str/includes? (str (message-of #(conn/session! registry conn-id "a")))
                           "This tab was closed"))
        (let [b (conn/session! registry conn-id "b")]
          (is (str/includes? (str (message-of #(sql/execute! {:sql/handle b} ["select x from t"])))
                             "no such table")
              "a new tab starts clean"))))))

(deftest retiring-a-tab-without-a-session
  (with-registry
    (fn [registry path]
      (let [{:keys [conn-id]} (conn/open! registry path)]
        (is (nil? (conn/retire-session! registry conn-id "never-ran")))
        (is (str/includes? (str (message-of #(conn/session! registry conn-id "never-ran")))
                           "This tab was closed"))
        (is (nil? (conn/retire-session! registry "nope" "x")) "an unknown database is a no-op")))))

(deftest close-removes-the-entry
  (with-registry
    (fn [registry path]
      (let [{:keys [conn-id]} (conn/open! registry path)]
        (conn/session! registry conn-id "a")
        (conn/session! registry conn-id "b")
        (is (nil? (conn/close! registry conn-id)))
        (is (not (contains? @registry conn-id)))
        (is (str/includes? (message-of #(conn/session! registry conn-id "a"))
                           "No open database"))))))

(deftest detach-then-session-fails
  (with-registry
    (fn [registry path]
      (let [{:keys [conn-id]} (conn/open! registry path)
            e (conn/detach! registry conn-id)]
        (is (some? e))
        (is (str/includes? (message-of #(conn/session! registry conn-id "a")) "No open database"))
        (is (nil? (conn/close-entry! e)))
        (is (nil? (conn/detach! registry conn-id)))))))

(deftest closing-an-unknown-id-is-a-no-op
  (with-registry
    (fn [registry _]
      (is (nil? (conn/close! registry "nope"))))))

(deftest halting-closes-everything
  (let [registry (ig/init-key :quel.conn/registry {})
        p1 (temp-path)
        p2 (temp-path)]
    (try
      (conn/open! registry p1)
      (let [{:keys [conn-id]} (conn/open! registry p2)]
        (conn/session! registry conn-id "a"))
      (ig/halt-key! :quel.conn/registry registry)
      (is (= {} @registry))
      (finally (os/sh "rm" "-f" p1 p2)))))

(deftest target-tells-paths-from-urls
  (is (= {:engine :sqlite :path "/tmp/a.db"} (conn/target " /tmp/a.db ")))
  (is (= {:engine :sqlite :path "relative.sqlite"} (conn/target "relative.sqlite")))
  (is (= {:engine :postgres :url "postgres://u:p@localhost:5432/db"}
         (conn/target "postgres://u:p@localhost:5432/db")))
  (is (= {:engine :postgres :url "postgres://localhost/db"}
         (conn/target "postgresql://localhost/db")))
  (is (= {:engine :postgres :url "postgres://localhost/db"}
         (conn/target "POSTGRES://localhost/db"))))

(deftest target-recognises-redshift
  (is (= {:engine :redshift :url "postgres://u:p@localhost:5439/dev"}
         (conn/target "redshift://u:p@localhost:5439/dev")))
  (is (= :redshift (:engine (conn/target "postgres://u:p@c1.abc123.us-east-1.redshift.amazonaws.com:5439/dev"))))
  (is (= :redshift (:engine (conn/target "postgres://u@wg.123456789012.eu-west-1.redshift-serverless.amazonaws.com:5439/dev"))))
  (is (= :postgres (:engine (conn/target "postgres://redshift.amazonaws.com.example.org/db")))
      "only a host that ends in a Redshift domain counts"))

(deftest the-label-masks-a-password
  (is (= "postgres://u:***@h:5432/db" (conn/label (conn/target "postgres://u:secret@h:5432/db"))))
  (is (= "postgres://u@h/db" (conn/label (conn/target "postgres://u@h/db"))))
  (is (= "postgres://h/db"
         (conn/label (conn/target "postgres://h/db?user=u&password=s3&sslmode=require"))))
  (is (= "postgres://h/db" (conn/label (conn/target "postgres://h/db?pass%77ord=s3")))
      "the query string is dropped whole, however a name is encoded")
  (is (= "/tmp/a.db" (conn/label (conn/target "/tmp/a.db")))))

(deftest connection-errors-hide-passwords
  (with-registry
    (fn [registry _]
      (let [msg (message-of #(conn/open! registry "postgres://localhost/db?password=supersecret&sslmode=invalid"))]
        (is (some? msg))
        (is (not (str/includes? (str msg) "supersecret")) (str "got " msg)))
      (let [msg (message-of #(conn/open! registry "postgres://u:supersecret@localhost:notaport/db"))]
        (is (some? msg))
        (is (not (str/includes? (str msg) "supersecret")) (str "got " msg))))))

(deftest redact-masks-what-looks-like-a-password
  (let [t (conn/target "postgres://u:s3@h/db?password=s4")]
    (is (= "cannot parse `postgres://u:***@h/db`" (conn/redact t "cannot parse `postgres://u:s3@h/db?password=s4`")))
    (is (= "host=h password=*** x" (conn/redact t "host=h password='a b' x")))))

(deftest open-target-uses-the-given-label
  (with-registry
    (fn [registry path]
      (spit path "")
      (let [r (conn/open-target! registry {:engine :sqlite :path path :label "My file"})]
        (is (= {:engine :sqlite :label "My file"} (dissoc r :conn-id)))
        (is (= "My file" (:label (get @registry (:conn-id r)))))))))

;; A password with a quote, a backslash and spaces, as the profile's DSN
;; carries it.
(def odd-secret "p'w \\tail x")
(def odd-dsn (str "host='h' port='5432' user='u' password=" (conn/dsn-quote odd-secret) " sslmode='prefer'"))

(defn- leaks? [msg]
  (some #(str/includes? msg %) ["p'w" "p\\'w" "tail" " x'"]))

(deftest redact-masks-the-secret
  (let [t {:engine :postgres :dsn odd-dsn :secret odd-secret}]
    (is (= "auth failed for *** ok" (conn/redact t (str "auth failed for " odd-secret " ok"))))
    (let [msg (conn/redact t (str "failed to connect to `" odd-dsn "`: refused"))]
      (is (not (leaks? msg)) msg))
    (let [msg (conn/redact t (str "cannot parse `" odd-dsn "`: invalid sslmode"))]
      (is (= "cannot parse the connection settings: invalid sslmode" msg)))))

(deftest check-a-sqlite-file
  (with-registry
    (fn [registry path]
      (spit path "")
      (is (nil? (conn/check! {:engine :sqlite :path path})))
      (is (empty? @registry)))))

(deftest check-a-dead-server
  (let [msg (message-of #(conn/check! {:engine :postgres :secret odd-secret
                                       :dsn (str "host='127.0.0.1' port='1' password="
                                                 (conn/dsn-quote odd-secret) " connect_timeout='2'")}))]
    (is (some? msg))
    (is (not (leaks? msg)) msg)))

;; pgx's own parse error, for a DSN Quel built by hand (validate would
;; refuse the SSL mode).
(deftest a-real-parse-failure-is-redacted
  (let [t {:engine :postgres :secret odd-secret
           :dsn (str "host='h' password=" (conn/dsn-quote odd-secret) " sslmode='bogus'")}
        msg (message-of #(conn/check! t))]
    (is (some? msg))
    (is (not (leaks? msg)) msg)))

;; The path goes to the driver as a URI, so a ? in a file name opens that
;; file, not the part before it.
(deftest a-question-mark-in-a-sqlite-path
  (let [dir (str/trim (:out (os/sh "mktemp" "-d")))
        path (str dir "/a?b #1.db")
        registry (ig/init-key :quel.conn/registry {})]
    (try
      (spit path "")
      (let [{:keys [conn-id]} (conn/open-target! registry {:engine :sqlite :path path :label "x"})]
        (sql/execute! (conn/db registry conn-id) ["create table marker (x int)"])
        (conn/close! registry conn-id))
      (is (nil? (os/stat (str dir "/a"))))
      (is (pos? (:size (os/stat path))))
      (finally
        (ig/halt-key! :quel.conn/registry registry)
        (os/sh "rm" "-rf" dir)))))

;; Dials under a ctx.

(deftest the-silent-port-stalls-a-dial
  (with-silent-port
    (fn [port]
      (let [t0 (System/nanoTime)
            msg (message-of #(conn/check! {:engine :postgres :dsn (silent-dsn port 2) :label "silent"}))]
        (is (some? msg))
        (is (<= 1500 (ms-since t0)) "the dial waited for connect_timeout")))))

(deftest a-cancel-stops-open-target
  (with-silent-port
    (fn [port]
      (with-registry
        (fn [registry _]
          (let [ctx (shim/NewCtx)
                t0 (System/nanoTime)
                _ (cancel-after 300 ctx)
                e (thrown-of #(conn/open-target! registry {:engine :postgres :dsn (silent-dsn port) :label "silent"} ctx))]
            (is (= "Connecting canceled." (ex-message e)))
            (is (= {:canceled true} (ex-data e)))
            (is (< (ms-since t0) 3000))
            (is (empty? @registry))))))))

(deftest a-cancel-stops-check
  (with-silent-port
    (fn [port]
      (let [ctx (shim/NewCtx)
            t0 (System/nanoTime)
            _ (cancel-after 300 ctx)
            msg (message-of #(conn/check! {:engine :postgres :dsn (silent-dsn port) :label "silent"} ctx))]
        (is (= "Connecting canceled." msg))
        (is (< (ms-since t0) 3000))))))

(deftest an-attempt-can-be-cancelled
  (with-silent-port
    (fn [port]
      (let [attempts (ig/init-key :quel.conn/attempts {})
            t0 (System/nanoTime)
            f (future (message-of #(conn/attempt! attempts "a1"
                                                  (fn [ctx] (conn/check! {:engine :postgres :dsn (silent-dsn port) :label "silent"} ctx)))))]
        (is (loop [n 0] (cond (contains? @attempts "a1") true (> n 200) false :else (do (sleep 10) (recur (inc n))))))
        (is (true? (conn/cancel-attempt! attempts "a1")))
        (is (= "Connecting canceled." (deref f 3000 :timeout)))
        (is (< (ms-since t0) 3000))
        (is (empty? @attempts) "the attempt deregistered")))))

(deftest attempts-are-refused-twice-and-unknown-cancels-are-false
  (let [attempts (ig/init-key :quel.conn/attempts {})]
    (is (false? (conn/cancel-attempt! attempts "nope")))
    (conn/attempt! attempts "a1"
                   (fn [_]
                     (is (str/includes? (str (message-of #(conn/attempt! attempts "a1" (fn [_] :inner))))
                                        "already running"))
                     (is (contains? @attempts "a1") "the first is still registered")))
    (is (empty? @attempts))
    (is (= :ok (conn/attempt! attempts nil (fn [ctx] (is (some? ctx)) :ok))) "no id: not registered")
    (is (empty? @attempts))))

(deftest halting-attempts-cancels-them
  (let [attempts (ig/init-key :quel.conn/attempts {})
        ctx (shim/NewCtx)]
    (swap! attempts assoc "a1" ctx)
    (ig/halt-key! :quel.conn/attempts attempts)
    (is (.Canceled ctx))))

(defn with-silent-entry
  "Run (f registry conn-id) with a hand-built Postgres entry whose pools
   dial the silent port (opening is lazy, so nothing dials yet)."
  [port f]
  (let [registry (ig/init-key :quel.conn/registry {})
        pool (fn [] (pg/open (silent-dsn port) {:postgres/cancel :request}))]
    (swap! registry assoc "silent" {:db (pool) :sessions-db (pool) :engine :postgres
                                    :label "silent" :sessions {} :retired #{}})
    (try
      (f registry "silent")
      (finally (ig/halt-key! :quel.conn/registry registry)))))

(deftest a-cancel-stops-a-session-dial
  (with-silent-port
    (fn [port]
      (with-silent-entry port
        (fn [registry conn-id]
          (let [ctx (shim/NewCtx)
                t0 (System/nanoTime)
                _ (cancel-after 300 ctx)
                msg (message-of #(conn/session! registry conn-id "s1" ctx))]
            (is (some? msg))
            (is (< (ms-since t0) 3000))
            (is (nil? (conn/current-session registry conn-id "s1")))))))))

;; A cancel that lands before the dial (during the Keychain read, say)
;; stops it before it starts.
(deftest a-ctx-cancelled-before-the-dial-never-dials
  (with-silent-port
    (fn [port]
      (with-registry
        (fn [registry _]
          (let [ctx (shim/NewCtx)
                t0 (System/nanoTime)]
            (.Cancel ctx)
            (is (= "Connecting canceled."
                   (message-of #(conn/open-target! registry {:engine :postgres :dsn (silent-dsn port) :label "silent"} ctx))))
            (is (< (ms-since t0) 500))
            (is (empty? @registry))))))))

;; DuckDB. Every test is in memory or in a temp dir.

(defn- with-temp-dir [f]
  (let [dir (str/trim (:out (os/sh "mktemp" "-d")))]
    (try (f dir) (finally (os/sh "rm" "-rf" dir)))))

(def ^:private duck-mem {:engine :duckdb :path ":memory:" :label "m"})

(defn- on [handle q]
  (sql/execute! {:sql/handle handle} [q]))

(deftest open-an-in-memory-duckdb
  (with-registry
    (fn [registry _]
      (let [r (conn/open-target! registry duck-mem)]
        (is (= :duckdb (:engine r)))
        (is (= "m" (:label r)))))))

;; One pool, so every connection shares the one in-memory instance, and the
;; instance outlives its connections even with no idle ones.
(deftest an-in-memory-duckdb-is-shared-by-every-session
  (with-registry
    (fn [registry _]
      (let [{:keys [conn-id]} (conn/open-target! registry duck-mem)
            s1 (conn/session! registry conn-id "a")
            s2 (conn/session! registry conn-id "b")]
        (on s1 "create table shared (x integer)")
        (on s1 "insert into shared values (7)")
        (is (= [{:x 7}] (on s2 "select x from shared")))
        (is (= [{:x 7}] (sql/execute! (conn/db registry conn-id) ["select x from shared"])))
        (.Close (conn/retire-session! registry conn-id "a"))
        (.Close (conn/retire-session! registry conn-id "b"))
        (is (= [{:x 7}] (on (conn/session! registry conn-id "c") "select x from shared")))))))

(deftest a-duckdb-temp-table-stays-in-its-session
  (with-registry
    (fn [registry _]
      (let [{:keys [conn-id]} (conn/open-target! registry duck-mem)
            s1 (conn/session! registry conn-id "a")
            s2 (conn/session! registry conn-id "b")]
        (on s1 "create temp table mine (x integer)")
        (is (= [] (on s1 "select x from mine")))
        (is (some? (message-of #(on s2 "select x from mine"))))))))

;; The driver caches instances by path, so a second open of a file shares
;; the first one's instance instead of failing on DuckDB's file lock.
(deftest two-opens-of-one-duckdb-file-share-it
  (with-temp-dir
    (fn [dir]
      (let [registry (ig/init-key :quel.conn/registry {})
            t {:engine :duckdb :path (str dir "/a.duckdb") :label "a"}]
        (try
          (let [a (:conn-id (conn/open-target! registry t))
                b (:conn-id (conn/open-target! registry t))]
            (sql/execute! (conn/db registry a) ["create table t (x integer)"])
            (sql/execute! (conn/db registry a) ["insert into t values (1)"])
            (is (= [{:x 1}] (sql/execute! (conn/db registry b) ["select x from t"])))
            (is (nil? (conn/check! t)))
            (conn/close! registry a)
            (sql/execute! (conn/db registry b) ["insert into t values (2)"])
            (is (= [{:n 2}] (sql/execute! (conn/db registry b) ["select count(*)::integer as n from t"]))))
          (finally (ig/halt-key! :quel.conn/registry registry)))))))

(deftest a-question-mark-in-a-duckdb-path-is-refused
  (with-temp-dir
    (fn [dir]
      (let [path (str dir "/a?b.duckdb")]
        (is (= "A DuckDB file path cannot contain ?." (conn/duckdb-path-error path)))
        (with-registry
          (fn [registry _]
            (is (= "A DuckDB file path cannot contain ?."
                   (message-of #(conn/open-target! registry {:engine :duckdb :path path :label "x"}))))
            (is (= "A DuckDB file path cannot contain ?."
                   (message-of #(conn/check! {:engine :duckdb :path path}))))))
        (is (nil? (os/stat (str dir "/a"))))))))

;; The driver url-parses the path: a % that is not an escape fails to
;; parse, so it is refused with a plain message. A valid escape, a # and a
;; space are kept as they are.
(deftest a-bad-percent-in-a-duckdb-path-is-refused
  (is (some? (conn/duckdb-path-error "/tmp/a%zz.duckdb")))
  (is (some? (conn/duckdb-path-error "/tmp/a%2.duckdb")))
  (is (nil? (conn/duckdb-path-error ":memory:")))
  (is (nil? (conn/duckdb-path-error "/tmp/a%20b #1.duckdb"))))

(deftest odd-duckdb-file-names-open-as-themselves
  (with-temp-dir
    (fn [dir]
      (let [path (str dir "/a%20b #1.duckdb")
            registry (ig/init-key :quel.conn/registry {})]
        (try
          (let [{:keys [conn-id]} (conn/open-target! registry {:engine :duckdb :path path :label "x"})]
            (sql/execute! (conn/db registry conn-id) ["create table marker (x int)"])
            (conn/close! registry conn-id))
          (finally (ig/halt-key! :quel.conn/registry registry)))
        (is (pos? (:size (os/stat path))))
        (is (= ["a%20b #1.duckdb"]
               (filterv #(not (str/ends-with? % ".wal"))
                        (str/split-lines (str/trim (:out (os/sh "ls" "-1" dir)))))))))))

(deftest closing-a-duckdb-closes-its-pool-once
  (with-registry
    (fn [registry _]
      (let [{:keys [conn-id]} (conn/open-target! registry duck-mem)
            e (get @registry conn-id)]
        (is (identical? (:db e) (:sessions-db e)))
        (conn/session! registry conn-id "a")
        (is (nil? (conn/close! registry conn-id)))
        (is (empty? @registry))))))

;; The bundled library reads both formats without downloading an extension.
(deftest duckdb-reads-csv-and-json-files
  (with-temp-dir
    (fn [dir]
      (spit (str dir "/f.csv") "a,b\n1,x\n2,y\n3,z\n")
      (spit (str dir "/f.json") "[{\"a\": 1}, {\"a\": 2}]")
      (with-registry
        (fn [registry _]
          (let [db (conn/db registry (:conn-id (conn/open-target! registry duck-mem)))]
            (is (= [{:n 3}] (sql/execute! db [(str "select count(*)::integer as n from read_csv('" dir "/f.csv')")])))
            (is (= [{:n 2}] (sql/execute! db [(str "select count(*)::integer as n from read_json_auto('" dir "/f.json')")])))))))))

(deftest check-a-file-that-is-not-duckdb
  (with-temp-dir
    (fn [dir]
      (let [path (str dir "/junk.duckdb")]
        (spit path "this is not a duckdb database, just some bytes\n")
        (is (some? (message-of #(conn/check! {:engine :duckdb :path path}))))))))

(deftest scan-row-follows-the-engine
  (with-registry
    (fn [registry path]
      (let [d (:conn-id (conn/open-target! registry duck-mem))
            s (:conn-id (conn/open! registry path))]
        (is (identical? (:sql/scan-row (conn/db registry d)) (conn/scan-row registry d)))
        (is (some? (conn/scan-row registry d)))
        (is (identical? shim/ScanRow (conn/scan-row registry s)))))))
