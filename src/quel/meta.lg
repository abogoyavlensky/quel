(ns quel.meta)

;; Introspection: what a database holds, for the structure tree and the
;; editor's completion. describe-schema and describe-object gather what
;; one expand of the tree shows. One multimethod per operation, dispatched on the
;; engine (:sqlite, :duckdb, :postgres, :redshift) and given the database's
;; pool as a sql.core connectable. The methods live in the engine
;; namespaces (quel.meta.sqlite, quel.meta.duckdb, quel.meta.postgres),
;; which require this one; quel.api loads them.
;;
;; Every query runs on the pool, never on a tab's session: browsing must
;; not wait behind a running query. So objects that live in one connection
;; only (temp tables, an ATTACH made in a tab) do not show.

(defmulti schemas
  "[{:name :default}], :default true for the schema unqualified names
   resolve to."
  (fn [engine _db] engine))

(defmulti objects
  "The schema's tables and views: [{:name :kind}], :kind \"table\",
   \"view\" or \"materialized-view\", sorted by name."
  (fn [engine _db _schema] engine))

(defmulti columns
  "The object's columns in order: [{:name :type}]. [] for an unknown
   object."
  (fn [engine _db _schema _name] engine))

(defmulti completion-rows
  "Every column completion offers: [{:schema :tbl :col}], ordered by
   schema, table and column position, at most completion-limit rows."
  (fn [engine _db] engine))

(defmulti functions
  "The schema's functions and procedures: [{:name :kind :args}], :kind
   \"function\" or \"procedure\", :args the argument types as text;
   sorted by name, then args. Extension members are left out."
  (fn [engine _db _schema] engine))

(defmulti types
  "The schema's own types: [{:name :kind :detail :values}], :kind
   \"enum\", \"domain\" or \"composite\"; :detail a domain's base type,
   else nil; :values an enum's labels in order, else []."
  (fn [engine _db _schema] engine))

(defmulti sequences
  "The schema's standalone sequences, the ones no column owns: [{:name}]."
  (fn [engine _db _schema] engine))

(defmulti indexes
  "The object's indexes: [{:name :definition :unique :primary}], sorted by
   name. :definition is the method and columns, \"btree (a, b)\"."
  (fn [engine _db _schema _name] engine))

(defmulti constraints
  "The object's keys: [{:name :kind :columns :definition}], :kind
   \"primary-key\", \"unique\", \"foreign-key\" or \"check\", in that
   order, then by name. :name is nil where the engine has none."
  (fn [engine _db _schema _name] engine))

(defmulti owned-sequences
  "The sequences the object's columns own (serial, identity):
   [{:name :column}]."
  (fn [engine _db _schema _name] engine))

;; An engine without the thing answers [].
(defmethod functions :default [_ _ _] [])
(defmethod types :default [_ _ _] [])
(defmethod sequences :default [_ _ _] [])
(defmethod indexes :default [_ _ _ _] [])
(defmethod constraints :default [_ _ _ _] [])
(defmethod owned-sequences :default [_ _ _ _] [])

(defn describe-schema
  "What the tree shows under a schema: {:objects :functions :types
   :sequences}, each a vector."
  [engine db schema]
  {:objects (vec (objects engine db schema))
   :functions (vec (functions engine db schema))
   :types (vec (types engine db schema))
   :sequences (vec (sequences engine db schema))})

(defn- key-columns [ks kind]
  (set (mapcat :columns (filter #(= kind (:kind %)) ks))))

(defn describe-object
  "What the tree shows under a table or view: {:columns :indexes :keys
   :sequences}. Each column carries :pk and :fk, true when a primary or
   foreign key lists it."
  [engine db schema name]
  (let [ks (vec (constraints engine db schema name))
        pk (key-columns ks "primary-key")
        fk (key-columns ks "foreign-key")]
    {:columns (mapv (fn [c] (assoc c :pk (contains? pk (:name c)) :fk (contains? fk (:name c))))
                    (columns engine db schema name))
     :indexes (vec (indexes engine db schema name))
     :keys ks
     :sequences (vec (owned-sequences engine db schema name))}))

;; Past this many columns, completion knows no more of the database.
(def completion-limit 50000)

(defn completion-schema
  "What the editor completes: {:default-schema s :schemas {schema {table
   [column ...]}}}. String keys, so names reach the frontend as they are."
  [engine db]
  (let [default (some #(when (:default %) (:name %)) (schemas engine db))]
    {:default-schema default
     :schemas (reduce (fn [m {:keys [schema tbl col]}]
                        (update-in m [schema tbl] (fnil conj []) col))
                      {}
                      (take completion-limit (completion-rows engine db)))}))
