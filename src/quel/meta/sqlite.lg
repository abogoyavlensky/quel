(ns quel.meta.sqlite
  (:require [quel.meta :as meta]
            [sql.core :as sql]
            [string :as str]))

;; SQLite's catalog, through its table-valued pragma functions (modernc
;; v1.57.0 is SQLite 3.5x; pragma_table_list needs 3.37).
;;
;; The temp schema is left out: the pool's temp schema is not any tab's.
;; Virtual tables (FTS and the like) list as tables, their shadow tables
;; not at all. pragma_table_xinfo rather than table_info, which omits
;; generated columns (hidden 2 and 3); hidden 1 is a virtual table's
;; hidden column.

(defmethod meta/schemas :sqlite [_ db]
  (mapv (fn [{:keys [name]}] {:name name :default (= "main" name)})
        (sql/execute! db ["select name from pragma_database_list where name <> 'temp' order by seq"])))

(def ^:private objects-sql
  (str "select name, type from pragma_table_list"
       " where schema = ? and type in ('table', 'view', 'virtual')"
       " and name not like 'sqlite\\_%' escape '\\'"
       " order by name"))

(defmethod meta/objects :sqlite [_ db schema]
  (mapv (fn [{:keys [name type]}] {:name name :kind (if (= "view" type) "view" "table")})
        (sql/execute! db [objects-sql schema])))

(defmethod meta/columns :sqlite [_ db schema name]
  (mapv (fn [{:keys [name type]}] {:name name :type type})
        (sql/execute! db ["select name, type from pragma_table_xinfo(?, ?) where hidden <> 1 order by cid"
                          name schema])))

;; Per object, catching errors one by one: a view over a dropped table
;; makes pragma_table_xinfo fail, and that must not lose the rest. A local
;; file, so the many small queries are cheap.
(defmethod meta/completion-rows :sqlite [_ db]
  (->> (meta/schemas :sqlite db)
       (mapcat (fn [{schema :name}]
                 (mapcat (fn [{tbl :name}]
                           (try
                             (mapv (fn [{col :name}] {:schema schema :tbl tbl :col col})
                                   (meta/columns :sqlite db schema tbl))
                             (catch _ [])))
                         (meta/objects :sqlite db schema))))
       (take meta/completion-limit)
       vec))

;; Indexes and keys. sqlite_autoindex_* indexes (from UNIQUE and a non-rowid
;; PRIMARY KEY) are listed: their names say what they are. A rowid INTEGER
;; PRIMARY KEY has no index at all.

(defn- index-columns [db schema index]
  (mapv (fn [{:keys [name]}] (or name "<expr>"))
        (sql/execute! db ["select name from pragma_index_info(?, ?) order by seqno" index schema])))

(defn- column-list [cols] (str "(" (str/join ", " cols) ")"))

(defn- index-list [db schema name]
  (sql/execute! db [(str "select name, \"unique\" as is_unique, origin, partial"
                         " from pragma_index_list(?, ?) order by name")
                    name schema]))

(defmethod meta/indexes :sqlite [_ db schema name]
  (mapv (fn [{index :name :keys [is_unique origin partial]}]
          {:name index
           :definition (str (column-list (index-columns db schema index))
                            (when (= 1 partial) " partial"))
           :unique (= 1 is_unique)
           :primary (= "pk" origin)})
        (index-list db schema name)))

(defn- primary-key [db schema name]
  (let [cols (mapv :name (sql/execute! db ["select name from pragma_table_xinfo(?, ?) where pk > 0 order by pk"
                                           name schema]))]
    (when (seq cols)
      [{:name nil :kind "primary-key" :columns cols :definition (str "PRIMARY KEY " (column-list cols))}])))

(defn- uniques [db schema name]
  (for [{index :name :keys [origin]} (index-list db schema name)
        :when (= "u" origin)
        :let [cols (index-columns db schema index)]]
    {:name nil :kind "unique" :columns cols :definition (str "UNIQUE " (column-list cols))}))

;; One row per column of each key, grouped by the key's id. A null "to" is
;; the parent's primary key.
(defn- foreign-keys [db schema name]
  (->> (sql/execute! db [(str "select id, \"table\" as parent, \"from\" as src, \"to\" as dst"
                              " from pragma_foreign_key_list(?, ?) order by id, seq")
                         name schema])
       (partition-by :id)
       (map (fn [rows]
              (let [src (mapv :src rows)
                    dst (keep :dst rows)
                    parent (:parent (first rows))]
                {:name nil :kind "foreign-key" :columns src
                 :definition (str "FOREIGN KEY " (column-list src) " REFERENCES " parent
                                  (when (seq dst) (column-list dst)))})))))

;; Check constraints live only in sqlite_schema.sql, so they are not listed.
(defmethod meta/constraints :sqlite [_ db schema name]
  (vec (concat (primary-key db schema name) (uniques db schema name) (foreign-keys db schema name))))
