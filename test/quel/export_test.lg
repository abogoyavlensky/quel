(ns quel.export-test
  (:require [integrant.core :as ig]
            [quel.export :as export]
            [quel.store-test :refer [temp-dir]]
            [string :as str]
            [clojure.test :refer [deftest is]]))

(defn- message-of [f]
  (try (f) nil (catch e (ex-message e))))

(deftest each-format-has-a-file-filter
  (is (= [["CSV" "*.csv"]] (export/filters "csv")))
  (is (= [["JSON" "*.json"]] (export/filters "json")))
  (is (= [["Markdown" "*.md"]] (export/filters "markdown"))))

(deftest an-unknown-format-throws
  (is (str/includes? (message-of #(export/filters "xml")) "xml")))

(defn- with-exports
  "Run (f exports dir target) over a registry and a throwaway dir."
  [f]
  (let [dir (temp-dir)
        exports (ig/init-key :quel.export/registry {})]
    (try
      (f exports dir (str dir "/result.csv"))
      (finally
        (ig/halt-key! :quel.export/registry exports)
        (os/sh "rm" "-rf" dir)))))

(defn- names [dir]
  (set (os/ls dir)))

(deftest an-export-ends-up-as-the-text-it-was-given
  (with-exports
    (fn [exports dir target]
      (let [id (export/begin! exports target)]
        (export/append! exports id "id,name\r\n")
        (export/append! exports id "1,Zoë — 日本\r\n")
        (is (= target (export/finish! exports id)))
        (is (= "id,name\r\n1,Zoë — 日本\r\n" (slurp target)))
        (is (= #{"result.csv"} (names dir)))
        (is (empty? @exports))))))

(deftest an-existing-file-is-replaced-only-by-finish
  (with-exports
    (fn [exports _ target]
      (spit target "old")
      (let [id (export/begin! exports target)]
        (export/append! exports id "new")
        (is (= "old" (slurp target)))
        (export/finish! exports id)
        (is (= "new" (slurp target)))))))

(deftest abort-leaves-the-target-and-drops-the-part-file
  (with-exports
    (fn [exports dir target]
      (spit target "old")
      (let [id (export/begin! exports target)]
        (export/append! exports id "new")
        (is (nil? (export/abort! exports id)))
        (is (= "old" (slurp target)))
        (is (= #{"result.csv"} (names dir)))
        (is (empty? @exports))))))

(deftest a-file-beside-the-target-is-not-touched
  (with-exports
    (fn [exports _ target]
      (let [neighbour (str target ".part")
            _ (spit neighbour "mine")
            id (export/begin! exports target)]
        (export/append! exports id "new")
        (export/abort! exports id)
        (is (= "mine" (slurp neighbour)))))))

(deftest two-exports-to-one-path-stay-whole
  (with-exports
    (fn [exports dir target]
      (let [a (export/begin! exports target)
            b (export/begin! exports target)]
        (export/append! exports a "first")
        (export/append! exports b "second")
        (export/finish! exports a)
        (is (= "first" (slurp target)))
        (export/finish! exports b)
        (is (= "second" (slurp target)))
        (is (= #{"result.csv"} (names dir)))))))

(deftest an-unknown-export-cannot-be-written
  (with-exports
    (fn [exports _ _]
      (is (= "This export is no longer open." (message-of #(export/append! exports "nope" "x"))))
      (is (= "This export is no longer open." (message-of #(export/finish! exports "nope"))))
      (is (nil? (export/abort! exports "nope"))))))

(deftest a-part-file-that-cannot-be-created-leaves-no-entry
  (with-exports
    (fn [exports dir _]
      (is (some? (message-of #(export/begin! exports (str dir "/missing/result.csv")))))
      (is (empty? @exports)))))

(deftest a-failed-rename-drops-the-part-file
  (with-exports
    (fn [exports dir target]
      ;; A directory with something in it cannot be renamed over.
      (mkdir (str target "/inside"))
      (let [id (export/begin! exports target)]
        (is (some? (message-of #(export/finish! exports id))))
        (is (= #{"result.csv"} (names dir)))
        (is (empty? @exports))))))

(deftest halting-drops-what-is-still-open
  (with-exports
    (fn [exports dir target]
      (export/begin! exports target)
      (ig/halt-key! :quel.export/registry exports)
      (is (empty? (os/ls dir)))
      (is (empty? @exports)))))
