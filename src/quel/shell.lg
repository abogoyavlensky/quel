(ns quel.shell
  (:require [integrant.core :as ig]
            [quel.window :as window]
            [wails.core :as w]))

;; The Wails application and its main window. Neither has a halt-key!:
;; the system halts from the app's :on-shutdown, while Wails is already
;; tearing both down, and the process ends right after.

;; opts go to w/new-app as they are (:name, :assets, :on-shutdown, ...).
(defmethod ig/init-key ::app [_ opts]
  (w/new-app opts))

;; :app is the application and :store the app database, read for the state
;; the window was left in; the rest goes to w/new-window.
(defmethod ig/init-key ::window [_ {:keys [app store] :as opts}]
  (w/new-window app (assoc (dissoc opts :app :store)
                           :start-state (window/start-state store))))
